#!/usr/bin/env bash
# Deploy the workstation to a running NixOS instance.
#
# Builds the workstation flake configuration on the local machine (or the CI
# runner) and copies the resulting store closure to the instance, then
# activates it. Everything is built once and reused wherever the workstation
# runs — any zone, any box — so the slow parts (for example the code-server
# Node build) are never repeated on the instance itself.
set -euo pipefail

PROGRAM="${0##*/}"
INSTANCE=""
PROJECT=""
ZONE=""
REPO=""

usage() {
  cat <<EOF
Usage: $PROGRAM --instance NAME --project PROJECT --zone ZONE [--repo DIR]

Build and activate the workstation flake on a running NixOS instance.

The build happens on this machine (a Linux machine with Nix and flakes); the
closure is copied to the instance and activated with a normal
switch-to-configuration. Requires SSH access to the instance's developer user,
which must have passwordless sudo (the base NixOS workstation config).
EOF
}

usage_error() {
  printf '%s: %s\n\n' "$PROGRAM" "$1" >&2
  usage >&2
  exit 2
}

while (($#)); do
  case "$1" in
    --instance) (($# >= 2)) || usage_error "Missing value for $1"; INSTANCE="$2"; shift 2;;
    --instance=*) INSTANCE="${1#*=}"; shift;;
    --project) (($# >= 2)) || usage_error "Missing value for $1"; PROJECT="$2"; shift 2;;
    --project=*) PROJECT="${1#*=}"; shift;;
    --zone) (($# >= 2)) || usage_error "Missing value for $1"; ZONE="$2"; shift 2;;
    --zone=*) ZONE="${1#*=}"; shift;;
    --repo) (($# >= 2)) || usage_error "Missing value for $1"; REPO="$2"; shift 2;;
    --repo=*) REPO="${1#*=}"; shift;;
    -h|--help) usage; exit 0;;
    *) usage_error "Unknown argument: $1";;
  esac
done
[[ -n "$INSTANCE" && -n "$PROJECT" && -n "$ZONE" ]] || usage_error "--instance, --project, and --zone are required"
[[ -n "$REPO" ]] || REPO="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"

die() { echo "$PROGRAM: $*" >&2; exit 1; }
command -v gcloud >/dev/null || die 'Install Google Cloud CLI'
command -v nix >/dev/null || die 'nix is required to build the workstation (Linux with flakes)'

GC=(--project "$PROJECT" --zone "$ZONE")

# Build the complete workstation configuration on this machine.
echo 'Building the workstation configuration...' >&2
out="$(cd "$REPO" && nix build '.#nixosConfigurations.workstation.config.system.build.toplevel' --no-link --print-out-paths)"
echo "built: $out" >&2

# Ensure the developer SSH key is known to the instance (injected by the guest
# agent), then resolve its external address for the closure copy.
gcloud compute ssh "developer@$INSTANCE" "${GC[@]}" --quiet --command true
IP="$(gcloud compute instances describe "$INSTANCE" "${GC[@]}" \
  --format='value(networkInterfaces[0].accessConfigs[0].natIP)')"
[[ -n "$IP" ]] || { echo "$PROGRAM: could not resolve $INSTANCE external IP" >&2; exit 1; }

# Copy the built closure to the instance using the same SSH key gcloud manages.
export NIX_SSHOPTS="-i $HOME/.ssh/google_compute_engine -o StrictHostKeyChecking=accept-new -o UserKnownHostsFile=$HOME/.ssh/known_hosts"
echo "copying the configuration closure to $IP..." >&2
nix copy --to "ssh://developer@$IP" "$out"

# Activate as root: point the system profile at the new generation and run the
# normal switch (including the bootloader) so the generation persists across
# reboots and appears in the serial-console rollback menu.
echo 'Activating the workstation configuration...' >&2
gcloud compute ssh "developer@$INSTANCE" "${GC[@]}" --quiet --command 'sudo bash -s' <<REMOTE
set -euo pipefail
export PATH="/run/current-system/sw/bin:/nix/var/nix/profiles/default/bin:\$PATH"
nix-env -p /nix/var/nix/profiles/system --set '$out'
env NIXOS_INSTALL_BOOTLOADER=1 '$out/bin/switch-to-configuration' switch
REMOTE

echo "deployed: $INSTANCE"
echo "generation: $out"