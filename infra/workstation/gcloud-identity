#!/usr/bin/env bash
# Configure GitHub Actions OIDC access to a GCP project.
set -euo pipefail
PROJECT=""; REPO=mcyster/workstation
while (($#)); do
 case "$1" in
 --project) PROJECT="$2"; shift 2;;
 --repo) REPO="$2"; shift 2;;
 *) echo "Usage: $0 --project PROJECT [--repo OWNER/REPO]" >&2; exit 2;;
 esac
done
[[ -n "$PROJECT" && "$REPO" == */* ]] || { echo 'Project and valid repo required' >&2; exit 2; }
NUMBER="$(gcloud projects describe "$PROJECT" --format='value(projectNumber)')"
SA="github-actions@$PROJECT.iam.gserviceaccount.com"
POOL=workstation-actions
PROVIDER=github
PREFIX="projects/$NUMBER/locations/global/workloadIdentityPools/$POOL"
for api in compute.googleapis.com iam.googleapis.com iamcredentials.googleapis.com sts.googleapis.com secretmanager.googleapis.com; do
 gcloud services enable "$api" --project "$PROJECT" >/dev/null
done
if ! gcloud iam service-accounts describe "$SA" --project "$PROJECT" >/dev/null 2>&1; then
 gcloud iam service-accounts create github-actions --project "$PROJECT" --display-name 'Workstation GitHub Actions'
fi
gcloud projects add-iam-policy-binding "$PROJECT" --member "serviceAccount:$SA" --role roles/compute.admin >/dev/null
COMPUTE_SA="$NUMBER-compute@developer.gserviceaccount.com"
gcloud iam service-accounts add-iam-policy-binding "$COMPUTE_SA" --project "$PROJECT" --member "serviceAccount:$SA" --role roles/iam.serviceAccountUser >/dev/null
if ! gcloud iam workload-identity-pools describe "$POOL" --location global --project "$PROJECT" >/dev/null 2>&1; then
 gcloud iam workload-identity-pools create "$POOL" --location global --project "$PROJECT" >/dev/null
fi
if ! gcloud iam workload-identity-pools providers describe "$PROVIDER" --workload-identity-pool "$POOL" --location global --project "$PROJECT" >/dev/null 2>&1; then
 gcloud iam workload-identity-pools providers create-oidc "$PROVIDER" --workload-identity-pool "$POOL" --location global --project "$PROJECT" --issuer-uri https://token.actions.githubusercontent.com --attribute-mapping 'google.subject=assertion.sub,attribute.repository=assertion.repository' --attribute-condition "assertion.repository == '$REPO'" >/dev/null
fi
gcloud iam service-accounts add-iam-policy-binding "$SA" --project "$PROJECT" --role roles/iam.workloadIdentityUser --member "principalSet://iam.googleapis.com/$PREFIX/attribute.repository/$REPO" >/dev/null
SECRET=workstation-web-terminal-password
if ! gcloud secrets describe "$SECRET" --project "$PROJECT" >/dev/null 2>&1; then
 gcloud secrets create "$SECRET" --project "$PROJECT" --replication-policy automatic >/dev/null
fi
gcloud secrets add-iam-policy-binding "$SECRET" --project "$PROJECT" --member "serviceAccount:$SA" --role roles/secretmanager.secretVersionAdder >/dev/null
printf 'WORKSTATION_GCLOUD_SERVICE_ACCOUNT=%s\nWORKSTATION_GCLOUD_WORKLOAD_IDENTITY_PROVIDER=%s/providers/%s\n' "$SA" "$PREFIX" "$PROVIDER"
