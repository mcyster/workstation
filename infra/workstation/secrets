#!/usr/bin/env bash
# Write a named workstation secret for any consumer.
#
# Runs on the instance as root. Reads the secret name from $1 and its dotenv
# content (KEY=VALUE or export KEY=VALUE) from WORKSTATION_ENV, then writes
# filtered KEY=VALUE lines to:
#   /var/lib/workstation/secrets/.env.NAME  (services read this via
#                                            EnvironmentFile)
#   /home/developer/.env.NAME               (developer shells and CLI tools
#                                            source it)
# and restarts the units Nix declares for NAME (Nix writes the unit list to
# /etc/workstation/secrets/NAME; see nixos/extensions/secrets.nix). A secret
# with no declared units (for example a CLI tool) is written but nothing is
# restarted. Nothing here knows a secret's name: it all flows from $1.
set -euo pipefail

# Destination directories. The first is created by Nix tmpfiles; tests override
# both so they run as a normal user.
SECRETS_DIR="${SECRETS_DIR:-/var/lib/workstation/secrets}"
DEVELOPER_HOME="${DEVELOPER_HOME:-/home/developer}"

# Keep only dotenv-style KEY=VALUE lines (optionally prefixed with "export ");
# strip the prefix so systemd's EnvironmentFile can source them. Ignore
# comments and blank lines, and pass quoted values through untouched.
filter_vars() {
  awk '/^(export[[:space:]]+)?[A-Za-z_][A-Za-z0-9_]*=/ { sub(/^(export[[:space:]]+)?/, ""); print }'
}

# Write only the valid secrets into file. Refuses to clobber an existing file
# with an empty result. Returns 0 on success, 1 when nothing usable was found.
write_secrets() {
  local input="${1:?input}" file="${2:?file}" owner="${3:?owner}" mode="${4:-0600}"
  local tmp filtered
  tmp="$(mktemp "${file}.XXXXXX")"
  trap 'rm -f "$tmp"' RETURN

  filtered="$(printf '%s\n' "$input" | filter_vars)"
  if [[ -z "$filtered" ]]; then
    echo "WORKSTATION_ENV has no valid KEY=VALUE lines; leaving $file intact" >&2
    return 1
  fi

  printf '%s\n' "$filtered" > "$tmp"
  chmod "$mode" "$tmp"
  mv -f "$tmp" "$file"
  chown "$owner" "$file"
}

# Restart the units Nix declared for this secret, if any. The manifest lives
# in the Nix store (unit names are not secret); when it is absent nothing
# needs restarting — exactly the case for CLI-only secrets such as `tog`.
restart_declared_units() {
  local name="${1:?name}" unit
  local manifest="${RESTART_FILE:-/etc/workstation/secrets/$name}"
  [[ -f "$manifest" ]] || return 0
  while read -r unit; do
    [[ -n "$unit" ]] || continue
    # If the unit is absent (declared by a newer config than the one
    # deployed), restart fails; the is-active checks below report it properly.
    systemctl restart "$unit" 2>/dev/null || true
    # Wait for the unit to come up before declaring success. is-active is
    # generic across units (no hardcoded HTTP probe here).
    for _ in {1..20}; do
      if systemctl is-active --quiet "$unit"; then break; fi
      sleep 2
    done
    if ! systemctl is-active --quiet "$unit"; then
      echo "$unit did not come back up after applying $name secrets" >&2
      return 1
    fi
  done < "$manifest"
}

main() {
  secret_name="${1:?secret name}"
  : "${WORKSTATION_ENV:?Set WORKSTATION_ENV}"
  if [[ ! "$secret_name" =~ ^[a-z][a-z0-9-]*$ ]]; then
    echo "invalid secret name: $secret_name" >&2
    return 1
  fi
  mkdir -p "$SECRETS_DIR" "$DEVELOPER_HOME"
  write_secrets "$WORKSTATION_ENV" "$SECRETS_DIR/.env.$secret_name" root:root 0600
  write_secrets "$WORKSTATION_ENV" "$DEVELOPER_HOME/.env.$secret_name" developer:users 0600
  restart_declared_units "$secret_name"
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
  main "$@"
fi
