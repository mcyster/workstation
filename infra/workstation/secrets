#!/usr/bin/env bash
# Apply workstation user environment secrets on the instance.
#
# Runs on the instance as root. Reads one record per line from the
# WORKSTATION_SECRET_PAYLOAD environment variable: NAME<TAB>BASE64. For each
# secret writes two files:
#
#   /home/developer/.env.NAME              original shell content (export
#                                          prefixes, comments, blank lines
#                                          preserved), developer:users 0600
#   /var/lib/workstation/secrets/.env.NAME systemd-compatible (optional
#                                          "export " prefix stripped, comments
#                                          and blank lines preserved),
#                                          root:root 0600
#
# and restarts every unit that references the secret's env file in its
# EnvironmentFile (discovered at runtime from systemd; no manifest or registry).
# A secret that no unit references is written without restarting anything.
#
# Every record is validated before any destination is touched, and each file
# is staged with its final owner and mode then replaced atomically. Unsupported
# content aborts with an error message that never repeats secret values.
set -euo pipefail

# Destination directories. The secrets directory is created by Nix tmpfiles;
# tests override both so they run as a normal user.
DEVELOPER_HOME="${DEVELOPER_HOME:-/home/developer}"
SECRETS_DIR="${SECRETS_DIR:-/var/lib/workstation/secrets}"

name_re='^[a-z][a-z0-9_-]*$'
line_re='^(export[[:space:]]+)?[A-Za-z_][A-Za-z0-9_]*='

validate_name() {
  [[ "$1" =~ $name_re ]]
}

# True when value is exactly one quote pair wrapping it (no embedded quotes).
# The length guard rejects a lone quote character, which would match the
# start-and-end glob without actually having an opening and closing quote.
quote_wrapped() {
  local value="$1" quote="$2"
  (( ${#value} >= 2 )) || return 1
  [[ "$value" == "${quote}"*"${quote}" && "${value:1:${#value}-2}" != *"$quote"* ]]
}

# Validate a value that must mean the same thing in the developer's shell and
# in systemd's EnvironmentFile. Allowed: a bare token or a fully quoted string
# ('...' or "..."). Rejected: `$`, backtick, backslash, or escapes anywhere
# (systemd treats them literally while a sourced shell may not), unquoted
# whitespace, and unterminated or embedded quotes.
validate_value() {
  local value="$1"
  [[ -n "$value" ]] || return 0   # empty value is fine
  case "$value" in
    *\$*|*\`*|*\\*) return 1 ;;  # expansions / escapes
  esac
  case "$value" in
    \"*\") quote_wrapped "$value" '"' || return 1; return 0 ;;
    \'*\') quote_wrapped "$value" "'" || return 1; return 0 ;;
  esac
  # Bare token: no quotes, whitespace, or shell operators. Operators like
  # & ; | ( ) < > would split the line when sourced, and ~ ! # * ? [ ] { }
  # would expand or comment differently, so they are only allowed inside a
  # quoted value.
  [[ "$value" =~ ^[A-Za-z0-9_@%+=.,:/-]+$ ]] || return 1
  return 0
}

# Reject unsupported content without echoing values. Comments and blank lines
# are fine; every other line must be KEY=VALUE or export KEY=VALUE, and its
# value must be a supported token.
validate_content() {
  local name="$1" content="$2" line_no=0 line value
  while IFS= read -r line || [[ -n "$line" ]]; do
    ((line_no++))
    [[ -z "$line" || "$line" == \#* || "$line" == \;* ]] && continue
    if [[ ! "$line" =~ $line_re ]]; then
      echo "secret $name: line $line_no is not a supported 'KEY=VALUE' line" >&2
      return 1
    fi
    value="${line#*=}"
    if ! validate_value "$value"; then
      echo "secret $name: line $line_no has an unsupported value (use KEY=VALUE with a plain or fully quoted value)" >&2
      return 1
    fi
  done <<< "$content"
}

# Strip an optional leading "export " prefix for systemd's EnvironmentFile;
# comments and blank lines pass through unchanged.
systemd_transform() {
  sed -E 's/^export[[:space:]]+//'
}

# Stage content in the destination directory with its final owner and mode,
# then replace the file atomically with mv. Every step is checked explicitly:
# apply_secret is invoked through `|| return`, which disables `set -e` for the
# whole call, so failures here must be propagated by hand. The staging runs in
# a subshell so the EXIT cleanup trap cannot leak into (or linger after) the
# surrounding functions.
stage_replace() {
  local file="$1" owner="$2" mode="$3" content="$4"
  mkdir -p "$(dirname "$file")" || return 1
  (
    local tmp
    tmp="$(mktemp "${file}.XXXXXX")" || exit 1
    # EXIT, not RETURN: an `exit 1` (failed write below) still triggers it,
    # so a failed stage never leaves a temporary secrets file behind.
    trap 'rm -f "$tmp"' EXIT
    printf '%s' "$content" > "$tmp" || exit 1
    if [[ "$content" != *$'\n' ]]; then
      printf '\n' >> "$tmp" || exit 1
    fi
    chown "$owner" "$tmp" || exit 1
    chmod "$mode" "$tmp" || exit 1
    mv -f "$tmp" "$file" || exit 1
  )
}

# Restart every unit that consumes this secret. Discovery is runtime: a unit
# consuming a secret loads it via EnvironmentFile=..., so we ask systemd which
# units reference the secrets file. There is no registry or manifest anywhere;
# the unit declarations themselves are the source of truth. list-unit-files
# (not list-units) is used so installed-but-not-loaded units are found too.
restart_declared_units() {
  local name="${1:?name}" unit needle
  needle="/var/lib/workstation/secrets/.env.$name"
  # `systemctl show` reports EnvironmentFile entries (with a `-` prefix shown
  # as `(ignore_errors=yes)`); match the secret path itself.
  while read -r unit; do
    [[ -n "$unit" ]] || continue
    systemctl show "$unit" -p EnvironmentFiles 2>/dev/null | grep -Fq "$needle" || continue
    # If the unit is absent (declared by a newer config than the one
    # deployed), restart fails; the is-active checks below report it.
    systemctl restart "$unit" 2>/dev/null || true
    for _ in {1..20}; do
      if systemctl is-active --quiet "$unit"; then break; fi
      sleep 2
    done
    if ! systemctl is-active --quiet "$unit"; then
      echo "$unit did not come back up after applying $name secrets" >&2
      return 1
    fi
  done < <(systemctl list-unit-files --type=service --no-legend --no-pager | awk '{print $1}')
}

apply_secret() {
  local name="$1" content="$2" systemd_content
  systemd_content="$(printf '%s' "$content" | systemd_transform)" || return 1
  stage_replace "$DEVELOPER_HOME/.env.$name" developer:users 0600 "$content" || return 1
  stage_replace "$SECRETS_DIR/.env.$name" root:root 0600 "$systemd_content" || return 1
  restart_declared_units "$name" || return 1
}

main() {
  : "${WORKSTATION_SECRET_PAYLOAD:-}"
  WORKSTATION_SECRET_PAYLOAD="${WORKSTATION_SECRET_PAYLOAD:-}"
  local -a names=() contents=()
  local name b64 decoded i
  while IFS=$'\t' read -r name b64; do
    [[ -n "$name" ]] || continue
    validate_name "$name" || {
      echo "invalid secret name: $name" >&2
      return 1
    }
    decoded="$(printf '%s' "$b64" | base64 -d 2>/dev/null)" || {
      echo "secret $name: could not decode payload" >&2
      return 1
    }
    names+=("$name")
    contents+=("$decoded")
  done <<< "$WORKSTATION_SECRET_PAYLOAD"

  if ((${#names[@]} == 0)); then
    echo 'no workstation secrets to apply' >&2
    return 0
  fi

  # Validate everything before writing anything.
  for ((i = 0; i < ${#names[@]}; i++)); do
    validate_content "${names[i]}" "${contents[i]}" || return 1
  done

  for ((i = 0; i < ${#names[@]}; i++)); do
    apply_secret "${names[i]}" "${contents[i]}" || return 1
  done
}

# Run when invoked directly or via `bash -s` (stdin), but not when sourced for
# tests. BASH_SOURCE[0] is empty under `bash -s`, so treat that as execution.
if [[ -z "${BASH_SOURCE[0]:-}" || "${BASH_SOURCE[0]}" == "$0" ]]; then
  main "$@"
fi
