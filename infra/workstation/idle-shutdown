#!/usr/bin/env bash
# Idempotent installer for an idle-triggered auto-shutdown watchdog.
#
# The watchdog powers the workstation off after it has been continuously
# idle for WORKSTATION_IDLE_HOURS, where "in use" means: a live SSH or
# code-server (web terminal) connection, or a sustained CPU load. An idle
# machine with no connections and little load is almost certainly forgotten,
# and stopping it ends running compute charges.
#
# Run as root on the workstation, e.g.:
#   bash scripts/workstation idle-shutdown main
# or, with gcloud directly:
#   gcloud compute ssh workstation-main --command 'sudo bash -s' < infra/workstation/idle-shutdown
set -euo pipefail

install -d -m 0755 /usr/local/sbin /etc/systemd/system

cat > /usr/local/sbin/workstation-idle-shutdown <<'SCRIPT'
#!/usr/bin/env bash
# Exit status 0 triggers poweroff; 1 means "in use or not yet idle".
set -u

# Optional tuning in /etc/default/workstation-idle-shutdown.
. /etc/default/workstation-idle-shutdown 2>/dev/null || true
: "${WORKSTATION_IDLE_HOURS:=4}"
: "${WORKSTATION_BOOT_GRACE_MIN:=15}"

STATE_DIR=/var/lib/workstation-idle
STATE_FILE=$STATE_DIR/last_active
mkdir -p "$STATE_DIR"

now=$(date +%s)

# Never power off shortly after boot (provisioning, package upgrades, reboots).
uptime_seconds=$(awk '{print int($1)}' /proc/uptime)
if (( uptime_seconds < WORKSTATION_BOOT_GRACE_MIN * 60 )); then
  printf '%s\n' "$now" > "$STATE_FILE"
  exit 1
fi

# A live SSH or web terminal connection means someone may be attached.
if ss -tnH state established | awk '{print $4}' | grep -Eq ':(22|8443)$'; then
  printf '%s\n' "$now" > "$STATE_FILE"   # reset the idle clock
  exit 1
fi

# Sustained background work (builds, installs, agents) keeps the box alive.
load1=$(awk '{print $1}' /proc/loadavg | cut -d. -f1)
if (( load1 >= "$(nproc)" )); then
  printf '%s\n' "$now" > "$STATE_FILE"
  exit 1
fi

# Idle this tick: power off once the box has been continuously idle long enough.
if [[ -f "$STATE_FILE" ]]; then
  elapsed=$(( now - $(cat "$STATE_FILE") ))
  if (( elapsed >= WORKSTATION_IDLE_HOURS * 3600 )); then
    echo "Workstation idle for $elapsed seconds; shutting down."
    systemctl poweroff
    exit 0
  fi
else
  printf '%s\n' "$now" > "$STATE_FILE"   # start counting idle from now
fi
exit 1
SCRIPT
chmod 755 /usr/local/sbin/workstation-idle-shutdown

if [[ ! -f /etc/default/workstation-idle-shutdown ]]; then
  cat > /etc/default/workstation-idle-shutdown <<'CONF'
# Idle period before the workstation powers itself off.
# WORKSTATION_IDLE_HOURS=4
# Minimum minutes after boot before auto-shutdown may run.
# WORKSTATION_BOOT_GRACE_MIN=15
CONF
fi

cat > /etc/systemd/system/workstation-idle-shutdown.service <<'SVC'
[Unit]
Description=Power off the workstation after a period of inactivity

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/workstation-idle-shutdown
SVC

cat > /etc/systemd/system/workstation-idle-shutdown.timer <<'TMR'
[Unit]
Description=Check the workstation for inactivity

[Timer]
OnBootSec=15min
OnUnitActiveSec=30min
AccuracySec=5min

[Install]
WantedBy=timers.target
TMR

systemctl daemon-reload
systemctl enable -q --now workstation-idle-shutdown.timer
systemctl start workstation-idle-shutdown.service >/dev/null 2>&1 || true
echo 'idle-shutdown: installed; idle after WORKSTATION_IDLE_HOURS (default 4h) with no SSH or web terminal and low load'