#!/usr/bin/env bash
# Rotate browser access credentials on the workstation.
#
# Runs on the instance as root. It writes the Caddy website password hash and
# the root recovery password to /var/lib/workstation (outside the Nix store),
# applies the root password, and restarts Caddy.
set -euo pipefail

: "${WEB_PASSWORD:?Set WEB_PASSWORD}"
: "${RECOVERY_PASSWORD:?Set RECOVERY_PASSWORD}"

mkdir -p /var/lib/workstation
umask 077

# Website password for the Caddy reverse proxy (basic auth).
if ! command -v caddy >/dev/null 2>&1; then
  echo 'Caddy is not installed; run the workstation configure step first.' >&2
  exit 1
fi
hash="$(caddy hash-password --plaintext "$WEB_PASSWORD")"
printf 'WORKSTATION_WEB_PASSWORD_HASH=%s\n' "$hash" > /var/lib/workstation/caddy.env
chown root:root /var/lib/workstation/caddy.env
chmod 600 /var/lib/workstation/caddy.env

# The same password protects the OpenCode server, so a single browser login
# works for the whole site. OpenCode always authenticates the user as
# `opencode`.
printf 'OPENCODE_SERVER_USERNAME=opencode\nOPENCODE_SERVER_PASSWORD=%s\n' "$WEB_PASSWORD" \
  > /var/lib/workstation/opencode.env
chown root:root /var/lib/workstation/opencode.env
chmod 600 /var/lib/workstation/opencode.env

# Root recovery password for the GCE serial console.
root_hash="$(printf '%s\n' "$RECOVERY_PASSWORD" | mkpasswd -m SHA-512 -s)"
printf '%s' "$root_hash" > /var/lib/workstation/recovery-password
chown root:root /var/lib/workstation/recovery-password
chmod 600 /var/lib/workstation/recovery-password
printf 'root:%s\n' "$root_hash" | chpasswd -e

# Self-signed certificate readable by the caddy user, refreshed with the
# current external IP so the browser warning matches the address in use.
mkdir -p /var/lib/caddy
ip="$(curl -fs --max-time 5 -H 'Metadata-Flavor: Google' \
  http://metadata.google.internal/computeMetadata/v1/instance/network-interfaces/0/access-configs/0/external-ip \
  2>/dev/null || true)"
subject_alt_name='DNS:workstation,DNS:localhost'
if [[ -n "$ip" ]]; then
  subject_alt_name="$subject_alt_name,IP:$ip"
fi
openssl req -x509 -newkey rsa:2048 -sha256 -nodes \
  -keyout /var/lib/caddy/workstation-key.pem \
  -out /var/lib/caddy/workstation-cert.pem -days 825 \
  -subj '/CN=workstation' \
  -addext "subjectAltName=$subject_alt_name"
chown caddy:caddy /var/lib/caddy/workstation-cert.pem /var/lib/caddy/workstation-key.pem
chmod 0644 /var/lib/caddy/workstation-cert.pem
chmod 0600 /var/lib/caddy/workstation-key.pem

systemctl restart opencode.service caddy.service

for _ in {1..20}; do
  if curl -ksf -u "opencode:$WEB_PASSWORD" https://127.0.0.1/ >/dev/null 2>&1; then
    exit 0
  fi
  sleep 2
done
echo 'Caddy did not start after rotating the password' >&2
exit 1