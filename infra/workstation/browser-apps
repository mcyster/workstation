#!/usr/bin/env bash
# Enable a service app behind the Caddy TLS terminator.
#
# Per-app install/config lives in app/NAME/setup.sh (run by the CLI as root
# before this). This script is generic: the service fields arrive on the
# environment (BROWSER_APP_PORT, BROWSER_APP_UPSTREAM, BROWSER_APP_USER,
# BROWSER_APP_WORKDIR, BROWSER_APP_EXEC) and it writes the systemd unit, Caddy
# site, password hash, and firewall wiring for any app.
#
# Usage (as root on the workstation):
#   BROWSER_APP_USER=... BROWSER_APP_WORKDIR=... BROWSER_APP_PORT=... \
#   BROWSER_APP_UPSTREAM=... BROWSER_APP_EXEC='...' ./browser-apps APP
set -euo pipefail

APP_NAME="${1:-}"
DEV_HOME=/home/developer
WORKSTATION_DIR=/etc/workstation
APP_LIST_FILE=$WORKSTATION_DIR/browser-apps
PASSWORD_ENV_FILE=$WORKSTATION_DIR/browser-apps.env
CADDY_BIN=/usr/local/bin/caddy
CADDY_DIR=/etc/caddy
CADDY_CFG=$CADDY_DIR/Caddyfile
SYSTEMD_DIR=/etc/systemd/system

die() { echo "browser-apps: $*" >&2; exit 1; }
[[ -n "$APP_NAME" ]] || die "usage: browser-apps APP"

install_caddy() {
  local caddy_arch
  case "$(uname -m)" in
    x86_64)  caddy_arch=amd64 ;;
    aarch64) caddy_arch=arm64 ;;
    *)       die "Unsupported architecture: $(uname -m)" ;;
  esac
  if [[ ! -x "$CADDY_BIN" ]]; then
    curl -fsSL "https://caddyserver.com/api/download?os=linux&arch=$caddy_arch" -o "$CADDY_BIN"
    chmod +x "$CADDY_BIN"
  fi
  if ! command -v htpasswd >/dev/null; then
    apt-get update >/dev/null
    apt-get install -y --no-install-recommends apache2-utils >/dev/null
  fi
}

write_password_hash() {
  local hash
  [[ -n "${BROWSER_APPS_PASSWORD:-}" ]] || return 0
  install -d -m 0755 "$WORKSTATION_DIR"
  hash="$(htpasswd -bnBC 12 "" "$BROWSER_APPS_PASSWORD" | tr -d ':\n')"
  umask 077
  printf 'BROWSER_APPS_PASSWORD_HASH=%s\n' "$hash" > "$PASSWORD_ENV_FILE"
  chmod 600 "$PASSWORD_ENV_FILE"
}

ensure_app_listed() {
  # Keep a TSV list of enabled apps (name, public port, upstream) so the
  # Caddyfile can be regenerated from the workstation alone.
  local tmp
  install -d -m 0755 "$WORKSTATION_DIR"
  tmp="$APP_LIST_FILE.$$"
  grep -v $'^'"$APP_NAME"$'\t' "$APP_LIST_FILE" 2>/dev/null > "$tmp" || true
  printf '%s\t%s\t%s\n' "$APP_NAME" "$BROWSER_APP_PORT" "$BROWSER_APP_UPSTREAM" >> "$tmp"
  mv "$tmp" "$APP_LIST_FILE"
}

ensure_self_signed_cert() {
  # Caddy cannot serve TLS on a hostless site (:PORT) with 'tls internal'
  # because there is no hostname to issue a certificate for. Provide an
  # explicit self-signed cert so IP-based browsing works (browser warning
  # expected).
  local certificate="$CADDY_DIR/internal.crt" private_key="$CADDY_DIR/internal.key"
  if [[ -f "$certificate" && -f "$private_key" ]]; then
    return 0
  fi
  install -d -m 0700 "$CADDY_DIR"
  openssl req -x509 -nodes -newkey rsa:2048 -sha256 -days 3650 \
    -subj "/CN=workstation" \
    -addext "subjectAltName=DNS:localhost,IP:127.0.0.1" \
    -keyout "$private_key" -out "$certificate" >/dev/null 2>&1
  chmod 600 "$private_key"
}

install_service() {
  cat > "$SYSTEMD_DIR/workstation-$APP_NAME.service" <<UNIT
[Unit]
Description=$APP_NAME workstation service
After=network-online.target

[Service]
User=$BROWSER_APP_USER
WorkingDirectory=$BROWSER_APP_WORKDIR
Environment=HOME=$BROWSER_APP_WORKDIR
EnvironmentFile=/home/developer/.env.$APP_NAME
ExecStart=$BROWSER_APP_EXEC
Restart=on-failure

[Install]
WantedBy=multi-user.target
UNIT
  systemctl daemon-reload
  systemctl enable -q --now "workstation-$APP_NAME.service" >/dev/null
  systemctl restart "workstation-$APP_NAME.service"
}

generate_caddyfile() {
  local app port upstream
  install -d -m 0755 "$CADDY_DIR"
  {
    echo '{'
    echo '  admin off'
    echo '  servers {'
    echo '    protocols h1 h2'
    echo '  }'
    echo '}'
    while IFS=$'\t' read -r app port upstream; do
      [[ -n "$app" ]] || continue
      echo
      echo "# $app"
      echo ":$port {"
      echo "  tls $CADDY_DIR/internal.crt $CADDY_DIR/internal.key"
      echo '  basic_auth {'
      # shellcheck disable=SC2016
      echo '    workstation {$BROWSER_APPS_PASSWORD_HASH}'
      echo '  }'
      echo "  reverse_proxy $upstream"
      echo '}'
    done < "$APP_LIST_FILE"
  } > "$CADDY_CFG"
}

start_caddy() {
  cat > /etc/systemd/system/caddy.service <<UNIT
[Unit]
Description=Caddy web server (browser apps TLS and auth)
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
EnvironmentFile=$PASSWORD_ENV_FILE
ExecStart=$CADDY_BIN run --config $CADDY_CFG --adapter caddyfile
ExecReload=$CADDY_BIN reload --config $CADDY_CFG --adapter caddyfile
Restart=on-failure
LimitNOFILE=1048576

[Install]
WantedBy=multi-user.target
UNIT
  systemctl daemon-reload
  systemctl enable -q --now caddy >/dev/null
  systemctl restart caddy
}

main() {
  : "${BROWSER_APP_PORT:?Set BROWSER_APP_PORT}"
  : "${BROWSER_APP_UPSTREAM:?Set BROWSER_APP_UPSTREAM}"
  : "${BROWSER_APP_USER:=developer}"
  : "${BROWSER_APP_WORKDIR:=$DEV_HOME}"
  : "${BROWSER_APP_EXEC:?Set BROWSER_APP_EXEC}"
  install_caddy
  ensure_app_listed
  write_password_hash
  ensure_self_signed_cert
  generate_caddyfile
  install_service
  start_caddy
  echo "browser-apps: $APP_NAME enabled behind Caddy"
}

if [[ -z "${BASH_SOURCE[0]:-}" || "${BASH_SOURCE[0]}" == "${0}" ]]; then
  main "$@"
fi