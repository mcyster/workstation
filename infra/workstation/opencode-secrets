#!/usr/bin/env bash
# Apply OpenCode user environment secrets on the workstation.
#
# Runs on the instance as root. Reads WORKSTATION_ENV_OPENCODE (dotenv lines:
# KEY=VALUE) and writes it to /var/lib/workstation/opencode-secrets.env —
# outside the Nix store — which the opencode systemd unit sources into the
# server process. The OpenCode web server then sees the provider keys and
# tokens (OPENROUTER_API_KEY, GH_TOKEN, and any other declared values).
set -euo pipefail

: "${WORKSTATION_ENV_OPENCODE:?Set WORKSTATION_ENV_OPENCODE}"

file=/var/lib/workstation/opencode-secrets.env
tmp="$(mktemp "${file}.XXXXXX")"
trap 'rm -f "$tmp"' EXIT

# Keep only dotenv-style KEY=VALUE lines; ignore comments and blank lines.
printf '%s\n' "$WORKSTATION_ENV_OPENCODE" |
  awk -F= '/^[A-Za-z_][A-Za-z0-9_]*=/ { print }' > "$tmp"
chmod 0600 "$tmp"
mv -f "$tmp" "$file"
chown root:root "$file"

systemctl restart opencode.service

for _ in {1..20}; do
  if curl -s -o /dev/null http://127.0.0.1:10999/; then
    exit 0
  fi
  sleep 2
done
echo 'opencode did not come back up after applying secrets' >&2
exit 1