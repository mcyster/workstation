#!/usr/bin/env bash
# Apply OpenCode user environment secrets on the workstation.
#
# Runs on the instance as root. Reads WORKSTATION_ENV_OPENCODE (dotenv lines:
# KEY=VALUE or export KEY=VALUE) and writes it to
# /var/lib/workstation/opencode-secrets.env — outside the Nix store — which the
# opencode systemd unit sources into the server process. The OpenCode web
# server then sees the provider keys and tokens (OPENROUTER_API_KEY, GH_TOKEN,
# and any other declared values). The destination is fixed here and in
# nixos/extensions/opencode.nix; keep both in sync.

# Keep only dotenv-style KEY=VALUE lines (optionally prefixed with "export ");
# strip the prefix so systemd's EnvironmentFile can source them. Ignore
# comments and blank lines, and pass quoted values through untouched.
filter_vars() {
  awk '/^(export[[:space:]]+)?[A-Za-z_][A-Za-z0-9_]*=/ { sub(/^(export[[:space:]]+)?/, ""); print }'
}

# Write only the valid secrets into file. Refuses to clobber an existing file
# with an empty result. Returns 0 on success, 1 when nothing usable was found.
write_secrets() {
  local input="${1:?input}" file="${2:?file}"
  local tmp filtered
  tmp="$(mktemp "${file}.XXXXXX")"
  trap 'rm -f "$tmp"' RETURN

  filtered="$(printf '%s\n' "$input" | filter_vars)"
  if [[ -z "$filtered" ]]; then
    echo "WORKSTATION_ENV_OPENCODE has no valid KEY=VALUE lines; leaving $file intact" >&2
    return 1
  fi

  printf '%s\n' "$filtered" > "$tmp"
  chmod 0600 "$tmp"
  mv -f "$tmp" "$file"
  chown root:root "$file"
}

# Wait until the server answers with something other than a server error. A
# 401 is expected until the browser authenticates, so it counts as healthy; a
# 5xx (or no response at all) does not. Attempts and delay are overridable so
# tests can run it quickly.
wait_healthy() {
  local url="${1:?url}" attempts="${2:-20}" delay="${3:-2}"
  local code
  for ((i = 0; i < attempts; i++)); do
    code="$(curl -s -o /dev/null -w '%{http_code}' --max-time 2 "$url" 2>/dev/null || true)"
    if [[ -n "$code" && "$code" != 000 && "$code" != 5* ]]; then
      return 0
    fi
    sleep "$delay"
  done
  return 1
}

main() {
  set -euo pipefail
  local file=/var/lib/workstation/opencode-secrets.env
  : "${WORKSTATION_ENV_OPENCODE:?Set WORKSTATION_ENV_OPENCODE}"

  write_secrets "$WORKSTATION_ENV_OPENCODE" "$file"
  systemctl restart opencode.service
  if wait_healthy http://127.0.0.1:10999/; then
    return 0
  fi
  echo 'opencode did not come back up after applying secrets' >&2
  return 1
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
  main "$@"
fi
