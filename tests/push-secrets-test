#!/usr/bin/env bash
# Test scripts/push-environment-secrets: name discovery, validation, the
# changed/same fingerprint logic, and how local secrets are uploaded to
# GitHub repository secrets.
set -euo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
script="$root/scripts/push-environment-secrets"
tmp="$(mktemp -d)"
SRC="$tmp/secrets-src"
STATE="$tmp/state"
SECRETS_FROM_GH="$tmp/gh-secrets.log"
export WORKSTATION_ENV_DIR="$SRC"
export XDG_STATE_HOME="$STATE"
trap 'rm -rf "$tmp"' EXIT
mkdir -p "$SRC" "$STATE"

# Stub gh: record repo + secret args, write the stdin value into a per-name
# file so the test can assert the exact uploaded content without echoing it.
stub_gh="$tmp/bin/gh"
mkdir -p "$tmp/bin"
cat > "$stub_gh" <<'EOF'
#!/usr/bin/env bash
if [[ "$1" == repo ]]; then
  echo mcyster/workstation
  exit 0
fi
if [[ "$1" == secret && "$2" == set ]]; then
  name=""
  while (($#)); do
    case "$1" in
      --repo) REPO="$2"; shift 2 ;;
      -*) shift ;;
      *) name="$1"; shift ;;
    esac
  done
  mkdir -p "$SECRETS_FROM_GH"
  cat > "$SECRETS_FROM_GH/$name"
  exit 0
fi
exit 1
EOF
chmod +x "$stub_gh"
export PATH="$tmp/bin:$PATH"
export SECRETS_FROM_GH

fail() { echo "FAIL: $*" >&2; exit 1; }

# --- discovery: pushes every ~/.env.* discovered -------------------------
printf '# comment\nexport TOG_SESSION=abc\n' > "$SRC/.env.tog"
printf 'OPENROUTER_API_KEY=sk-x\n' > "$SRC/.env.opencode"
bash "$script" --yes >/dev/null
[[ -f "$SECRETS_FROM_GH/WORKSTATION_ENV_TOG" ]] || fail 'top-level TOG secret not set'
[[ -f "$SECRETS_FROM_GH/WORKSTATION_ENV_OPENCODE" ]] || fail 'opencode secret not set'
[[ "$(cat "$SECRETS_FROM_GH/WORKSTATION_ENV_TOG")" == $'# comment\nexport TOG_SESSION=abc' ]] \
  || fail 'TOG secret content not preserved verbatim'

# --- fingerprint: unchanged files are skipped -----------------------------
rm -rf "$SECRETS_FROM_GH"
bash "$script" --yes > "$tmp/out1" 2>&1
[[ ! -e "$SECRETS_FROM_GH" ]] || fail 'unchanged secrets should not be re-pushed'

# --- fingerprint: changed file is pushed ----------------------------------
printf 'export TOG_SESSION=def\n' > "$SRC/.env.tog"
bash "$script" --yes >/dev/null
[[ "$(cat "$SECRETS_FROM_GH/WORKSTATION_ENV_TOG")" == 'export TOG_SESSION=def' ]] \
  || fail 'changed TOG secret not re-pushed'
[[ ! -e "$SECRETS_FROM_GH/WORKSTATION_ENV_OPENCODE" ]] || fail 'unchanged opencode was re-pushed'

# --- explicit names and unknown name -------------------------------------
rm -rf "$SECRETS_FROM_GH"
printf 'GH_TOKEN=ghp_\n' > "$SRC/.env.tog"
bash "$script" --yes tog >/dev/null
[[ "$(cat "$SECRETS_FROM_GH/WORKSTATION_ENV_TOG")" == 'GH_TOKEN=ghp_' ]] || fail 'explicit name upload failed'
if bash "$script" --yes nonexistent 2>/dev/null; then
  fail 'explicit unknown name should not be pushed'
fi

# --- invalid name rejected ------------------------------------------------
printf 'X=1\n' > "$SRC/.env.Bad Name"
if bash "$script" --yes 'Bad Name' 2>/dev/null; then
  fail 'invalid name should be rejected'
fi
# GitHub secret names cannot contain hyphens; a hyphenated name must be
# rejected before upload.
printf 'X=1\n' > "$SRC/.env.foo-bar"
if bash "$script" --yes 'foo-bar' 2>/dev/null; then
  fail 'hyphenated name should be rejected'
fi

echo 'push-environment-secrets tests: OK'
