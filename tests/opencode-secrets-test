#!/usr/bin/env bash
# Test infra/workstation/opencode-secrets against realistic input: export
# prefixes, quoted values, inline '=', comments, blank lines, and the
# guarantee that invalid input leaves an existing secrets file intact.
set -euo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
script="$root/infra/workstation/opencode-secrets"
stubs="$(mktemp -d)"
tmp="$(mktemp -d)"
trap 'rm -rf "$stubs" "$tmp"' EXIT

# Stub external programs so the tests run as a normal user: curl answers with
# a configurable status code, systemctl and chown are no-ops.
cat > "$stubs/curl" <<'EOF'
#!/usr/bin/env bash
if [[ "${CURL_FAIL:-0}" == 1 ]]; then
  exit 7 # connection refused
fi
printf '%s\n' "${CURL_STATUS:-200}"
exit 0
EOF
cat > "$stubs/systemctl" <<'EOF'
#!/usr/bin/env bash
exit 0
EOF
cat > "$stubs/chown" <<'EOF'
#!/usr/bin/env bash
exit 0
EOF
chmod +x "$stubs/curl" "$stubs/systemctl" "$stubs/chown"
export PATH="$stubs:$PATH"

# shellcheck source=../infra/workstation/opencode-secrets
source "$script"

fail() {
  echo "FAIL: $*" >&2
  exit 1
}

# --- filter_vars: mixed, realistic input ---------------------------------
input=$'# a comment line\nexport OPENROUTER_API_KEY=sk-abc123\nGH_TOKEN="ghp_quoted"\n\nFOO=bar\nexport  MULTI=line\nexport FLAG=\nnot-a-valid-line\n'
got="$(printf '%s\n' "$input" | filter_vars)"
expected=$'OPENROUTER_API_KEY=sk-abc123\nGH_TOKEN="ghp_quoted"\nFOO=bar\nMULTI=line\nFLAG='
if [[ "$got" != "$expected" ]]; then
  fail "filter_vars: expected [$(printf '%s' "$expected" | od -An -tx1)], got [$(printf '%s' "$got" | od -An -tx1)]"
fi

# --- filter_vars: inline '=' in the value survives -----------------------
got="$(printf '%s\n' 'CONNECTION=user=pass@host' | filter_vars)"
[[ "$got" == 'CONNECTION=user=pass@host' ]] || fail 'filter_vars dropped inline equals'

# --- filter_vars: nothing but comments/blank/invalid is empty ------------
got="$(printf '%s\n' $'# comment\n\njust words' | filter_vars)"
[[ -z "$got" ]] || fail 'filter_vars should return nothing for invalid input'

# --- write_secrets: writes filtered content ------------------------------
file="$tmp/secrets.env"
write_secrets "$input" "$file"
[[ -f "$file" ]] || fail 'write_secrets did not create the file'
[[ "$(cat "$file")" == "$expected" ]] || fail 'write_secrets wrote unexpected content'

# --- write_secrets: invalid input leaves an existing file intact ---------
write_secrets $'OLD_KEEP=2\n' "$file"
write_secrets $'# only a comment\n\nnot valid\n' "$file" 2>/dev/null && fail 'write_secrets should fail on invalid input'
[[ "$(cat "$file")" == 'OLD_KEEP=2' ]] || fail 'write_secrets clobbered an existing file with invalid input'

# --- wait_healthy --------------------------------------------------------
CURL_STATUS=200 wait_healthy http://127.0.0.1:10999/ 1 0 || fail '200 should be healthy'
CURL_STATUS=401 wait_healthy http://127.0.0.1:10999/ 1 0 || fail '401 should be healthy (auth expected)'
if CURL_STATUS=500 wait_healthy http://127.0.0.1:10999/ 1 0; then
  fail '500 should not be healthy'
fi
if CURL_FAIL=1 wait_healthy http://127.0.0.1:10999/ 1 0; then
  fail 'no response should not be healthy'
fi

echo 'opencode-secrets tests: OK'
