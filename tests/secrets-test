#!/usr/bin/env bash
# Test infra/workstation/secrets against the WORKSTATION_SECRET_PAYLOAD
# protocol: export prefixes, quoted values, comments, blank lines, the two
# destination files (original vs systemd-form), validation-before-write, and
# declared-unit restarts.
set -euo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
script="$root/infra/workstation/secrets"
stubs="$(mktemp -d)"
tmp="$(mktemp -d)"
SECRETS_DIR="$tmp/secrets"
DEVELOPER_HOME="$tmp/home"
SYSTEMCTL_LOG="$tmp/systemctl.log"
CHOWN_LOG="$tmp/chown.log"
export SECRETS_DIR DEVELOPER_HOME SYSTEMCTL_LOG CHOWN_LOG
trap 'rm -rf "$stubs" "$tmp"' EXIT

# Stub external programs so the tests run as a normal user: chown and curl are
# no-ops, sleep is instant. systemctl emulates just the bits the script uses:
# list-units/show for runtime consumer discovery, restart logging, and
# is-active (which can simulate a failed unit).
SYSTEMCTL_UNITS_FILE="$tmp/units"
SYSTEMCTL_UNIT_DIR="$tmp/unit-files"
mkdir -p "$SYSTEMCTL_UNIT_DIR"
: > "$SYSTEMCTL_UNITS_FILE"
export SYSTEMCTL_UNITS_FILE SYSTEMCTL_UNIT_DIR
cat > "$stubs/curl" <<'EOF'
#!/usr/bin/env bash
exit 0
EOF
cat > "$stubs/chown" <<'EOF'
#!/usr/bin/env bash
printf '%s\n' "$*" >> "$CHOWN_LOG"
exit 0
EOF
cat > "$stubs/systemctl" <<'EOF'
#!/usr/bin/env bash
if [[ "$1" == list-unit-files || "$1" == list-units ]]; then
  cat "$SYSTEMCTL_UNITS_FILE" 2>/dev/null
  exit 0
fi
if [[ "$1" == show ]]; then
  unit="$2"
  cat "$SYSTEMCTL_UNIT_DIR/$unit" 2>/dev/null
  exit 0
fi
if [[ "$1" == is-active && "${IS_ACTIVE_FAIL:-0}" == 1 ]]; then
  exit 1
fi
printf '%s\n' "$*" >> "$SYSTEMCTL_LOG"
exit 0
EOF
cat > "$stubs/sleep" <<'EOF'
#!/usr/bin/env bash
exit 0
EOF
chmod +x "$stubs/curl" "$stubs/chown" "$stubs/systemctl" "$stubs/sleep"
export PATH="$stubs:$PATH"

# shellcheck source=../infra/workstation/secrets
source "$script"

fail() {
  echo "FAIL: $*" >&2
  exit 1
}

encode() { printf '%s' "$1" | base64 | tr -d '\n'; }

# --- validate_content ----------------------------------------------------
validate_content tog $'# header\nTOG_SESSION=abc\n' || fail 'valid content rejected'
validate_content tog $'export TOG_SESSION=abc\n\n# footer\n' || fail 'export + comments + blank rejected'
validate_content tog $'TOKEN="abc 123"\n' || fail 'quoted value with spaces rejected'
validate_content tog $'CONNECTION=user=pass@host\n' || fail 'inline equals in value rejected'
validate_content tog $'EMPTY=\n' || fail 'empty value rejected'
validate_content tog $'URL="https://x?a=1&b=2"\n' || fail 'quoted value with operators rejected'

if validate_content tog $'TOG_SESSION=abc\nnot valid line\n' 2>/dev/null; then
  fail 'garbage line should be rejected'
fi
if validate_content tog $'\t indented failure\n' 2>/dev/null; then
  fail 'indented garbage should be rejected'
fi
if validate_content tog $'TOG_SESSION\n' 2>/dev/null; then
  fail 'line without = should be rejected'
fi
if validate_content tog $'KEY=$OTHER\n' 2>/dev/null; then
  fail 'shell expansion in value should be rejected'
fi
if validate_content tog $'KEY="unterminated\n' 2>/dev/null; then
  fail 'unterminated quote should be rejected'
fi
if validate_content tog $'KEY="\n' 2>/dev/null; then
  fail 'lone double quote should be rejected'
fi
if validate_content tog $'KEY='"'"'\n' 2>/dev/null; then
  fail 'lone single quote should be rejected'
fi
if validate_content tog $'KEY=value with spaces\n' 2>/dev/null; then
  fail 'unquoted whitespace value should be rejected'
fi
if validate_content tog $'KEY=some"thing"\n' 2>/dev/null; then
  fail 'embedded quote should be rejected'
fi
if validate_content tog $'export KEY=$OTHER\n' 2>/dev/null; then
  fail 'export with shell expansion should be rejected'
fi
# Unquoted shell operators must be rejected: sourcing KEY=abc&true would run
# `true` rather than assign `abc` — a different meaning than systemd reads.
for op in '&' ';' '|' '(' ')' '<' '>' '~' '{' '}' '*'; do
  if validate_content tog "KEY=abc${op}cde"$'\n' 2>/dev/null; then
    fail "unquoted shell operator ${op} should be rejected"
  fi
done
# The same operators are fine inside properly quoted values.
validate_content tog $'KEY="a&b;c|d"\n' || fail 'double-quoted operators should be allowed'
validate_content tog "KEY='a&b;c|d'"$'\n' || fail 'single-quoted operators should be allowed'

# --- validate_name -------------------------------------------------------
validate_name tog || fail 'tog should be a valid name'
validate_name 'a-b_c' || fail 'dash/underscore should be valid'
if validate_name '../x' 2>/dev/null; then fail 'path traversal name accepted'; fi
if validate_name 'X y' 2>/dev/null; then fail 'space in name accepted'; fi

# --- systemd_transform ---------------------------------------------------
in=$'# header\nexport TOG_SESSION=abc\nGH_TOKEN="q"\n\n# footer\n'
out="$(printf '%s' "$in" | systemd_transform)"
[[ "$out" == $'# header\nTOG_SESSION=abc\nGH_TOKEN="q"\n\n# footer' ]] \
  || fail "systemd_transform mismatch: [$(printf '%s' "$out" | od -An -tx1)]"

# --- main: writes both destinations, preserving original vs systemd -------
# A consumer unit that loads this secret via its EnvironmentFile.
printf '%s\n' 'workstation-tog.service loaded active running' > "$SYSTEMCTL_UNITS_FILE"
printf 'EnvironmentFiles=/var/lib/workstation/secrets/.env.tog (ignore_errors=yes)\n' \
  > "$SYSTEMCTL_UNIT_DIR/workstation-tog.service"
: > "$SYSTEMCTL_LOG"; : > "$CHOWN_LOG"
payload="tog"$'\t'"$(encode $'# header\nexport TOG_SESSION=abc\nGH_TOKEN="q"\n\n# footer\n')"$'\n'
export WORKSTATION_SECRET_PAYLOAD="$payload"
main

# Developer copy: original content preserved verbatim (export, comments,
# blank lines). $(cat ...) strips a trailing newline, so compare without it.
[[ -f "$DEVELOPER_HOME/.env.tog" ]] || fail 'developer copy missing'
[[ "$(cat "$DEVELOPER_HOME/.env.tog")" == $'# header\nexport TOG_SESSION=abc\nGH_TOKEN="q"\n\n# footer' ]] \
  || fail 'developer copy not preserved verbatim'
grep -q '^developer:users ' "$CHOWN_LOG" || fail 'developer copy not chowned to developer:users'

# Systemd copy: export stripped, comments/blank preserved.
[[ -f "$SECRETS_DIR/.env.tog" ]] || fail 'systemd copy missing'
[[ "$(cat "$SECRETS_DIR/.env.tog")" == $'# header\nTOG_SESSION=abc\nGH_TOKEN="q"\n\n# footer' ]] \
  || fail 'systemd copy not transformed correctly'
grep -q '^root:root ' "$CHOWN_LOG" || fail 'systemd copy not chowned to root:root'

# Unit discovered as a consumer (its EnvironmentFile references the secret) is
# restarted.
grep -q '^restart workstation-tog.service$' "$SYSTEMCTL_LOG" || fail 'consumer unit not restarted'

# --- runtime discovery: a unit with no reference to the secret is ignored ---
printf '%s\n' 'unrelated.service loaded active running' > "$SYSTEMCTL_UNITS_FILE"
printf 'EnvironmentFiles=/etc/somewhere/env\n' > "$SYSTEMCTL_UNIT_DIR/unrelated.service"
: > "$SYSTEMCTL_LOG"
restart_declared_units tog
[[ ! -s "$SYSTEMCTL_LOG" ]] || fail 'unrelated unit should not be restarted'

# --- main: invalid content must leave existing files intact --------------
printf '%s\n' 'OLD_SESSION=2' > "$DEVELOPER_HOME/.env.tog"
printf '%s\n' 'OLD_SESSION=2' > "$SECRETS_DIR/.env.tog"
bad_payload="tog"$'\t'"$(encode $'OLD_SESSION=2\nnot valid line\n')"$'\n'
export WORKSTATION_SECRET_PAYLOAD="$bad_payload"
if main 2>/dev/null; then
  fail 'main should fail on invalid content'
fi
[[ "$(cat "$DEVELOPER_HOME/.env.tog")" == 'OLD_SESSION=2' ]] || fail 'developer copy clobbered by invalid content'
[[ "$(cat "$SECRETS_DIR/.env.tog")" == 'OLD_SESSION=2' ]] || fail 'systemd copy clobbered by invalid content'

# --- main: empty payload is a no-op --------------------------------------
export WORKSTATION_SECRET_PAYLOAD=""
main || fail 'empty payload should succeed as a no-op'

# --- main: invalid secret name is rejected --------------------------------
export WORKSTATION_SECRET_PAYLOAD=$'../x\tZm9v\n'
if main 2>/dev/null; then
  fail 'path traversal secret name should be rejected'
fi

# --- restart_declared_units: a unit that never activates is reported -----
: > "$SYSTEMCTL_LOG"
printf '%s\n' 'unit-a.service loaded active running' > "$SYSTEMCTL_UNITS_FILE"
printf 'EnvironmentFiles=/var/lib/workstation/secrets/.env.tog (ignore_errors=yes)\n' \
  > "$SYSTEMCTL_UNIT_DIR/unit-a.service"
if IS_ACTIVE_FAIL=1 restart_declared_units tog 2>/dev/null; then
  fail 'a unit that never activates should be reported'
fi

# --- stage_replace: a failing chown must propagate and leave no file -----
orig="$SECRETS_DIR/.env.failprop"
mkdir -p "$SECRETS_DIR"
printf '%s\n' 'ORIG=1' > "$orig"
stub_fail="$(mktemp -d)"
cat > "$stub_fail/chown" <<'EOF'
#!/usr/bin/env bash
exit 1
EOF
chmod +x "$stub_fail/chown"
if PATH="$stub_fail:$PATH" stage_replace "$orig" root:root 0600 'KEEP=1' 2>/dev/null; then
  fail 'stage_replace should propagate a failing chown'
fi
[[ "$(cat "$orig")" == 'ORIG=1' ]] || fail 'stage_replace replaced the destination after a failed chown'
# mktemp templates look like dest.XXXXXX; no such leftovers allowed.
if ls "$SECRETS_DIR"/.env.failprop.* >/dev/null 2>&1; then
  fail "stage_replace left temp files behind: $(ls -A "$SECRETS_DIR")"
fi

# --- main: propagation of a failing chown through apply_secret ------------
export WORKSTATION_SECRET_PAYLOAD="failprop"$'\t'"$(encode $'KEEP=1\n')"$'\n'
rm -f "$SECRETS_DIR/.env.failprop"
if PATH="$stub_fail:$PATH" main 2>/dev/null; then
  fail 'main should propagate a failing chown'
fi
[[ ! -e "$SECRETS_DIR/.env.failprop" ]] || fail 'main wrote a destination after a failed chown'
if ls "$SECRETS_DIR"/.env.failprop.* >/dev/null 2>&1; then
  fail "main left temp files behind after a failed chown: $(ls -A "$SECRETS_DIR")"
fi
rm -rf "$stub_fail"

# --- stage_replace: non-writable dir leaves no temp file behind -----------
readonly_dir="$(mktemp -d)"
chmod 0500 "$readonly_dir"
if stage_replace "$readonly_dir/x" root:root 0600 'KEEP=1' 2>/dev/null; then
  fail 'stage_replace should propagate a failing write'
fi
[[ -z "$(ls -A "$readonly_dir")" ]] || fail "failing write left temp file behind: $(ls -A "$readonly_dir")"
chmod 0700 "$readonly_dir"
rm -rf "$readonly_dir"

echo 'workstation secrets tests: OK'
