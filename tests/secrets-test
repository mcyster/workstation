#!/usr/bin/env bash
# Test infra/workstation/secrets against realistic input: export prefixes,
# quoted values, comments, blank lines, the two destination files, declared
# unit restarts, and the guarantee that invalid input leaves existing files
# intact.
set -euo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
script="$root/infra/workstation/secrets"
stubs="$(mktemp -d)"
tmp="$(mktemp -d)"
SECRETS_DIR="$tmp/secrets"
DEVELOPER_HOME="$tmp/home"
RESTART_FILE="$tmp/restart-manifest"
SYSTEMCTL_LOG="$tmp/systemctl.log"
export SECRETS_DIR DEVELOPER_HOME RESTART_FILE SYSTEMCTL_LOG
trap 'rm -rf "$stubs" "$tmp"' EXIT

# Stub external programs so the tests run as a normal user: systemctl records
# its invocations, chown is a no-op, curl is a no-op.
cat > "$stubs/curl" <<'EOF'
#!/usr/bin/env bash
exit 0
EOF
cat > "$stubs/chown" <<'EOF'
#!/usr/bin/env bash
exit 0
EOF
cat > "$stubs/systemctl" <<'EOF'
#!/usr/bin/env bash
if [[ "$1" == is-active && "${IS_ACTIVE_FAIL:-0}" == 1 ]]; then
  exit 1
fi
printf '%s\n' "$*" >> "$SYSTEMCTL_LOG"
exit 0
EOF
cat > "$stubs/sleep" <<'EOF'
#!/usr/bin/env bash
exit 0
EOF
chmod +x "$stubs/curl" "$stubs/chown" "$stubs/systemctl" "$stubs/sleep"
export PATH="$stubs:$PATH"

# shellcheck source=../infra/workstation/secrets
source "$script"

fail() {
  echo "FAIL: $*" >&2
  exit 1
}

# --- filter_vars: mixed, realistic input ---------------------------------
input=$'# a comment line\nexport OPENROUTER_API_KEY=sk-abc123\nGH_TOKEN="ghp_quoted"\n\nFOO=bar\nexport  MULTI=line\nexport FLAG=\nnot-a-valid-line\n'
got="$(printf '%s\n' "$input" | filter_vars)"
expected=$'OPENROUTER_API_KEY=sk-abc123\nGH_TOKEN="ghp_quoted"\nFOO=bar\nMULTI=line\nFLAG='
if [[ "$got" != "$expected" ]]; then
  fail "filter_vars: expected [$(printf '%s' "$expected" | od -An -tx1)], got [$(printf '%s' "$got" | od -An -tx1)]"
fi

# --- filter_vars: inline '=' in the value survives -----------------------
got="$(printf '%s\n' 'CONNECTION=user=pass@host' | filter_vars)"
[[ "$got" == 'CONNECTION=user=pass@host' ]] || fail 'filter_vars dropped inline equals'

# --- filter_vars: nothing but comments/blank/invalid is empty ------------
got="$(printf '%s\n' $'# comment\n\njust words' | filter_vars)"
[[ -z "$got" ]] || fail 'filter_vars should return nothing for invalid input'

# --- write_secrets: writes filtered content ------------------------------
file="$SECRETS_DIR/.env.opencode"
mkdir -p "$SECRETS_DIR"
write_secrets "$input" "$file" root:root 0600
[[ -f "$file" ]] || fail 'write_secrets did not create the file'
[[ "$(cat "$file")" == "$expected" ]] || fail 'write_secrets wrote unexpected content'

# --- write_secrets: invalid input leaves an existing file intact ---------
write_secrets $'OLD_KEEP=2\n' "$file" root:root 0600
if write_secrets $'# only a comment\n\nnot valid\n' "$file" root:root 0600 2>/dev/null; then
  fail 'write_secrets should fail on invalid input'
fi
[[ "$(cat "$file")" == 'OLD_KEEP=2' ]] || fail 'write_secrets clobbered an existing file with invalid input'

# --- restart_declared_units: restarts declared units ---------------------
printf '%s\n' 'unit-a' 'unit-b' > "$RESTART_FILE"
: > "$SYSTEMCTL_LOG"
restart_declared_units unit-a   # RESTART_FILE exported above
grep -q '^restart unit-a$' "$SYSTEMCTL_LOG" || fail 'unit-a was not restarted'
grep -q '^restart unit-b$' "$SYSTEMCTL_LOG" || fail 'unit-b was not restarted'

# --- restart_declared_units: no manifest means no restart ---------------
: > "$SYSTEMCTL_LOG"
rm -f "$RESTART_FILE"
restart_declared_units unit-a
[[ ! -s "$SYSTEMCTL_LOG" ]] || fail 'no manifest should restart nothing'

# --- restart_declared_units: failed unit is reported ---------------------
printf '%s\n' 'unit-a' > "$RESTART_FILE"
: > "$SYSTEMCTL_LOG"
if IS_ACTIVE_FAIL=1 restart_declared_units unit-a 2>/dev/null; then
  fail 'a unit that never activates should be reported'
fi

echo 'workstation secrets tests: OK'
