#!/usr/bin/env bash
# Workstation command-line interface for Google Compute Engine.
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
NAME=main
PROJECT=""
ZONE=""
MACHINE_TYPE=e2-standard-2
IMAGE_PROJECT=ubuntu-os-cloud
IMAGE_FAMILY=ubuntu-2404-lts-amd64
ENVIRONMENT=""
ENVIRONMENTS=()
WEB=false
OPENCODE=false
YES=false
ACTION=""
usage() { cat <<'HELP'
Usage: workstation COMMAND [NAME] [--project PROJECT] [--zone ZONE]
       workstation create [NAME] [--machine-type TYPE] [--web-terminal|--opencode] [--environment NAME[,NAME...]]
       workstation configure [NAME] --environment NAME[,NAME...]
Commands: create, configure, idle-shutdown, opencode, opencode-link, start, stop, list, shell, config-ssh, web-terminal, destroy
web-terminal enables the code-server browser editor; opencode enables the opencode web UI.
Both are served by Caddy on https://IP:8443 and :8444 behind one browser-apps password.
opencode-link prints a one-time pairing link that signs the browser into opencode web.
configure applies one or more environment apps (comma-separated) from the apps.json app registry, in order.
idle-shutdown installs the auto-shutdown watchdog (also run automatically after setup).
Default name: main. Default machine type: e2-standard-2.
Stop retains disk; destroy permanently deletes disk.
HELP
}
die() { echo "workstation: $*" >&2; exit 1; }
while (($#)); do
 case "$1" in
   -h|--help) usage; exit 0;;
   --project|--zone|--machine-type|--environment) (($#>=2)) || die "Missing value for $1"; case "$1" in --project) PROJECT="$2";; --zone) ZONE="$2";; --machine-type) MACHINE_TYPE="$2";; --environment) ENVIRONMENT="$2";; esac; shift 2;;
   --project=*) PROJECT="${1#*=}"; shift;;
   --zone=*) ZONE="${1#*=}"; shift;;
   --machine-type=*) MACHINE_TYPE="${1#*=}"; shift;;
   --environment=*) ENVIRONMENT="${1#*=}"; shift;;
   --web-terminal) WEB=true; shift;;
   --opencode) OPENCODE=true; shift;;
   --yes) YES=true; shift;;
   create|configure|idle-shutdown|opencode|opencode-link|start|stop|list|shell|config-ssh|web-terminal|destroy) [[ -z "$ACTION" ]] || die 'Duplicate command'; ACTION="$1"; shift;;
   -*) die "Unknown option $1";;
   *) NAME="$1"; shift;;
 esac
done
[[ -n "$ACTION" ]] || { usage; exit 2; }
if [[ ! "$NAME" =~ ^[a-z]([-a-z0-9]*[a-z0-9])?$ ]] || ((${#NAME} > 47)); then
  die 'Invalid workstation name'
fi
if [[ -n "$ENVIRONMENT" ]]; then
  # Accept one or more environments, comma- or whitespace-separated.
  split="${ENVIRONMENT//[, ]/ }"
  split="${split//$'\n'/ }"
  read -r -a ENVIRONMENTS <<< "$split"
  filtered=()
  for environment in "${ENVIRONMENTS[@]}"; do
    [[ -n "$environment" ]] || continue
    [[ "$environment" =~ ^[a-z]([-a-z0-9]*[a-z0-9])?$ ]] || die "Invalid environment name: $environment"
    for seen in "${filtered[@]}"; do
      [[ "$seen" == "$environment" ]] && continue 2
    done
    filtered+=("$environment")
  done
  ENVIRONMENTS=("${filtered[@]}")
fi
if ((${#ENVIRONMENTS[@]} == 0)); then
  mapfile -t ENVIRONMENTS < <(default_environments)
fi
[[ "$ACTION" != configure || -n "${ENVIRONMENTS[*]}" ]] || die 'configure requires --environment'
command -v gcloud >/dev/null || die 'Install Google Cloud CLI'
command -v jq >/dev/null || die 'Install jq'
PROJECT="${PROJECT:-$(gcloud config get-value project 2>/dev/null)}"
ZONE="${ZONE:-$(gcloud config get-value compute/zone 2>/dev/null)}"
[[ "$PROJECT" != '(unset)' && -n "$PROJECT" ]] || die 'Specify --project'
INSTANCE="workstation-$NAME"
BROWSER_APPS_PASSWORD_SECRET="$INSTANCE-web-terminal-password"
GCLOUD_ARGS=(--project "$PROJECT")
if [[ "$ACTION" != list && "$ACTION" != config-ssh ]]; then
 [[ "$ZONE" != '(unset)' && -n "$ZONE" ]] || die 'Specify --zone'
 GCLOUD_ARGS+=(--zone "$ZONE")
fi
field() { gcloud compute instances describe "$INSTANCE" "${GCLOUD_ARGS[@]}" --format="value($1)" 2>/dev/null || true; }
status() { field status; }
wait_ssh() {
  local attempt
  attempt=0
  while (( attempt < 40 )); do
    if gcloud compute ssh "$INSTANCE" "${GCLOUD_ARGS[@]}" --quiet --command true >/dev/null 2>&1; then return 0; fi
    sleep 5
    attempt=$(( attempt + 1 ))
  done
  die 'SSH did not become available'
}
ensure_setup() {
  wait_ssh
  if ! gcloud compute ssh "$INSTANCE" "${GCLOUD_ARGS[@]}" --quiet --command 'sudo test -f /var/lib/workstation-setup.done' >/dev/null 2>&1; then
    echo 'Completing workstation setup...'
    gcloud compute ssh "$INSTANCE" "${GCLOUD_ARGS[@]}" --quiet --command 'sudo bash -s' < "$ROOT/infra/workstation/setup"
  fi
  # Install (or refresh) the idle auto-shutdown watchdog on every management call.
  gcloud compute ssh "$INSTANCE" "${GCLOUD_ARGS[@]}" --quiet --command 'sudo bash -s' < "$ROOT/infra/workstation/idle-shutdown" >/dev/null || die 'Could not install idle shutdown'
  gcloud compute ssh "$INSTANCE" "${GCLOUD_ARGS[@]}" --quiet --command 'sudo test -f /var/lib/workstation-setup.done' >/dev/null 2>&1 || die 'Workstation setup did not complete'
}
APPS_JSON="$ROOT/apps.json"
app_env_names() {
  # Apps with an env file: each maps to a fixed GitHub secret WORKSTATION_ENV_<APP>
  # whose value is written to ~/.env.<app> on the workstation.
  jq -r 'to_entries[] | select(.value.env == true) | .key' "$APPS_JSON"
}
app_service_apps() {
  # Apps that run as a supervised service behind Caddy.
  jq -r 'to_entries[] | select(.value.service != null) | .key' "$APPS_JSON"
}
app_environment_names() {
  # Apps selectable as a configurable environment (have a setup script).
  jq -r 'to_entries[] | select(.value.environment == true) | .key' "$APPS_JSON"
}
default_environments() {
  # Environment apps loaded by default when none are specified.
  jq -r 'to_entries[] | select(.value.environment == true and .value.default == true) | .key' "$APPS_JSON"
}
app_service_field() {
  jq -r --arg app "$1" --arg field "$2" '.[$app].service[$field] // empty' "$APPS_JSON"
}
app_setup_path() {
  jq -r --arg app "$1" '.[$app].setup // empty' "$APPS_JSON"
}
tool_env_var() {
  printf 'WORKSTATION_ENV_%s\n' "$(printf '%s' "$1" | tr '[:lower:]' '[:upper:]')"
}
emit_tool_env_files() {
  # Emit remote shell lines that write each set WORKSTATION_ENV_<TOOL> value to
  # ~/.env.<tool> (0600) and source it (set -a), so tools and the environment
  # script see the variables. Paths use $HOME so they resolve on the remote
  # host (the user running the bundle), not on the machine that emits it.
  local tool tool_var value_file value_q wrote_files=()
  for tool in $(app_env_names); do
    tool_var="$(tool_env_var "$tool")"
    value_file="${!tool_var:-}"
    if [[ -n "$value_file" ]]; then
      value_file="$(printf '%s\n' "$value_file" | sed -E 's/^[[:space:]]*export[[:space:]]+//')"
      value_q="$(printf '%q' "$value_file")"
      printf 'umask 077\n'
      printf '%s\n' "printf '%s\\n' ${value_q} > \$HOME/.env.${tool}"
      # shellcheck disable=SC2016
      printf 'chmod 600 $HOME/.env.%s\n' "$tool"
      wrote_files+=("$tool")
    fi
  done
  if ((${#wrote_files[@]})); then
    printf 'set -a\n'
    for tool in "${wrote_files[@]}"; do
      # shellcheck disable=SC2016
      printf '. $HOME/.env.%s\n' "$tool"
    done
    printf 'set +a\n'
  fi
}
materialize_tool_env_files() {
  # Write tool env files now (e.g. right after create, without an environment
  # script), using whatever WORKSTATION_ENV_<TOOL> values are in the CLI's
  # environment. No-op when none are set.
  ensure_setup                      # developer must exist before sudo -u developer
  [[ "$(status)" == RUNNING ]] || return 0
  (
    umask 077
    bundle="$(mktemp)"
    trap 'rm -f "$bundle"' EXIT
    {
      printf 'set -euo pipefail\nset +x\n'
      emit_tool_env_files
    } > "$bundle"
    [[ "$(grep -vc '^$' "$bundle")" -gt 3 ]] || return 0   # only boilerplate: nothing to write
    gcloud compute ssh "$INSTANCE" "${GCLOUD_ARGS[@]}" --quiet \
      --command 'sudo -H -u developer bash -l -se' < "$bundle" >/dev/null
  )
}
restart_service_apps() {
  # Reload service apps so they pick up env-file changes from their
  # EnvironmentFile. try-restart no-ops for units that are not running.
  local app units=()
  for app in $(app_service_apps); do units+=("workstation-$app.service"); done
  ((${#units[@]})) || return 0
  [[ "$(status)" == RUNNING ]] || return 0
  gcloud compute ssh "$INSTANCE" "${GCLOUD_ARGS[@]}" --quiet \
    --command "sudo systemctl try-restart ${units[*]}" >/dev/null 2>&1 || true
}
configure_environment() {
  [[ "$(status)" == RUNNING ]] || die 'Workstation must be running'
  ensure_setup

  local environment setup_script bundle
  for environment in "${ENVIRONMENTS[@]}"; do
    [[ " $(app_environment_names) " == *" $environment "* ]] || die "Not a configurable environment app: $environment"
    setup_script="$ROOT/$(app_setup_path "$environment")"
    [[ -f "$setup_script" ]] || die "Environment setup script not found: $setup_script"

    (
      umask 077
      bundle="$(mktemp)"
      trap 'rm -f "$bundle"' EXIT

      {
        printf 'set -euo pipefail\nset +x\n'
        printf 'export WORKSTATION_ENVIRONMENT=%q\n' "$environment"
        printf 'export WORKSTATION_NAME=%q\n' "$NAME"
        emit_tool_env_files
        cat "$setup_script"
      } > "$bundle"

      gcloud compute ssh "$INSTANCE" "${GCLOUD_ARGS[@]}" --quiet \
        --command 'sudo -H -u developer bash -l -se' < "$bundle"
    )

    echo "environment: $environment"
  done
  restart_service_apps
}
browser_app_tag() {
  printf 'workstation-%s\n' "$1"
}
browser_app_port() {
  app_service_field "$1" "port"
}
store_browser_apps_password() {
  local password="$1"
  if ! gcloud secrets describe "$BROWSER_APPS_PASSWORD_SECRET" --project "$PROJECT" >/dev/null 2>&1; then
    gcloud secrets create "$BROWSER_APPS_PASSWORD_SECRET" --project "$PROJECT" --replication-policy automatic \
      --labels managed-workstation=true,workstation="$NAME" >/dev/null
  fi
  if ! printf %s "$password" | gcloud secrets versions add "$BROWSER_APPS_PASSWORD_SECRET" --project "$PROJECT" --data-file=- >/dev/null; then
    die 'Password changed on VM but not saved in Secret Manager. Run web-terminal or opencode again.'
  fi
}
ensure_browser_app_tag() {
  # Idempotently expose a browser app's port through tags and a firewall rule.
  local app="$1" tag port
  tag="$(browser_app_tag "$app")"
  port="$(browser_app_port "$app")"
  if [[ "$(field 'tags.items')" != *"$tag"* ]]; then
    gcloud compute instances add-tags "$INSTANCE" "${GCLOUD_ARGS[@]}" --tags "$tag" >/dev/null
  fi
  if ! gcloud compute firewall-rules describe "$tag" --project "$PROJECT" >/dev/null 2>&1; then
    gcloud compute firewall-rules create "$tag" --project "$PROJECT" --allow "tcp:$port" --target-tags "$tag" >/dev/null
  fi
}
enable_browser_app() {
  # enable_browser_app APP [ROTATE] [PASSWORD]
  # ROTATE=true or a new workstation forces a fresh password. An explicit
  # PASSWORD is used for all apps in one rotation; the caller stores it.
  local app="$1" rotate_mode="${2:-false}" password="${3:-}"
  local port upstream user workdir exec_line generated_value=false setup_script
  [[ "$(status)" == RUNNING ]] || die 'Workstation must be running'
  ensure_setup
  ensure_browser_app_tag "$app"
  port="$(app_service_field "$app" "port")"
  upstream="$(app_service_field "$app" "upstream")"
  user="$(app_service_field "$app" "user")"
  workdir="$(app_service_field "$app" "working_dir")"
  exec_line="$(jq -r --arg app "$app" '.[$app].service.exec | join(" ")' "$APPS_JSON")"

  # Per-app install/config (binary, files) runs first, as root.
  setup_script="$ROOT/app/$app/setup.sh"
  if [[ -f "$setup_script" ]]; then
    gcloud compute ssh "$INSTANCE" "${GCLOUD_ARGS[@]}" --quiet \
      --command 'sudo bash -s' < "$setup_script" >/dev/null
  fi

  if [[ -z "$password" ]]; then
    if [[ "$rotate_mode" == true ]] || ! gcloud secrets describe "$BROWSER_APPS_PASSWORD_SECRET" --project "$PROJECT" >/dev/null 2>&1; then
      password="$(head -c 64 /dev/urandom | base64 | tr -dc a-zA-Z0-9 | head -c 32)"
      generated_value=true
    fi
  fi
  if [[ -n "$password" ]]; then
    gcloud compute ssh "$INSTANCE" "${GCLOUD_ARGS[@]}" --quiet \
      --command "sudo BROWSER_APPS_PASSWORD='$password' BROWSER_APP_USER='$user' BROWSER_APP_WORKDIR='$workdir' BROWSER_APP_PORT='$port' BROWSER_APP_UPSTREAM='$upstream' BROWSER_APP_EXEC='$exec_line' bash -s '$app'" < "$ROOT/infra/workstation/browser-apps" >/dev/null
  else
    # Reuse the existing bcrypt hash; just make sure the app is behind Caddy.
    gcloud compute ssh "$INSTANCE" "${GCLOUD_ARGS[@]}" --quiet \
      --command "sudo BROWSER_APP_USER='$user' BROWSER_APP_WORKDIR='$workdir' BROWSER_APP_PORT='$port' BROWSER_APP_UPSTREAM='$upstream' BROWSER_APP_EXEC='$exec_line' bash -s '$app'" < "$ROOT/infra/workstation/browser-apps" >/dev/null
  fi
  if ! gcloud compute ssh "$INSTANCE" "${GCLOUD_ARGS[@]}" --quiet --command 'sudo test -f /etc/workstation/browser-apps' >/dev/null 2>&1; then
    die 'Browser app install did not complete on the workstation'
  fi
  if [[ "$generated_value" == true ]]; then
    store_browser_apps_password "$password"
  fi
  echo "$app: https://$(field 'networkInterfaces[0].accessConfigs[0].natIP'):$port"
  echo "secret: $BROWSER_APPS_PASSWORD_SECRET"
  echo "password: https://console.cloud.google.com/security/secret-manager/secret/$BROWSER_APPS_PASSWORD_SECRET?project=$PROJECT"
}
rotate() {
  # rotate [APP...] : rotate one shared password, then enable each app.
  # With no arguments, the service apps currently tagged on the instance.
  local app password apps=()
  if (($#)); then
    apps=("$@")
  else
    for app in $(app_service_apps); do
      if [[ "$(field 'tags.items')" == *"$(browser_app_tag "$app")"* ]]; then
        apps+=("$app")
      fi
    done
  fi
  ((${#apps[@]})) || return 0
  [[ "$(status)" == RUNNING ]] || die 'Workstation must be running'
  ensure_setup
  password="$(head -c 64 /dev/urandom | base64 | tr -dc a-zA-Z0-9 | head -c 32)"
  store_browser_apps_password "$password"
  for app in "${apps[@]}"; do
    enable_browser_app "$app" true "$password"
  done
}
case "$ACTION" in
 create)
    if [[ -z "$(status)" ]]; then
      gcloud compute machine-types describe "$MACHINE_TYPE" "${GCLOUD_ARGS[@]}" >/dev/null
      # GCE executes startup-script metadata directly; no cloud-init dependency is required.
      gcloud compute instances create "$INSTANCE" "${GCLOUD_ARGS[@]}" \
        --machine-type "$MACHINE_TYPE" \
        --image-project "$IMAGE_PROJECT" \
        --image-family "$IMAGE_FAMILY" \
        --labels managed-workstation=true \
        --metadata-from-file="startup-script=$ROOT/infra/workstation/setup"
    else echo "$INSTANCE already exists"; fi
    app_args=()
    [[ "$WEB" == true ]] && app_args+=(code)
    [[ "$OPENCODE" == true ]] && app_args+=(opencode)
    if ((${#app_args[@]})); then rotate "${app_args[@]}"; else ensure_setup; fi
    materialize_tool_env_files
    [[ -z "${ENVIRONMENTS[*]}" ]] || configure_environment
    restart_service_apps
    ;;
  configure) configure_environment;;
 idle-shutdown)
   [[ "$(status)" == RUNNING ]] || die 'Workstation not running'
   gcloud compute ssh "$INSTANCE" "${GCLOUD_ARGS[@]}" --quiet --command 'sudo bash -s' < "$ROOT/infra/workstation/idle-shutdown"
   ;;
 start)
   [[ -n "$(status)" ]] || die 'Workstation does not exist'
   if [[ "$(status)" != RUNNING ]]; then
     gcloud compute instances start "$INSTANCE" "${GCLOUD_ARGS[@]}"
     rotate
   fi
   ;;
 stop) [[ -n "$(status)" ]] || die 'Workstation does not exist'; [[ "$(status)" == TERMINATED ]] || gcloud compute instances stop "$INSTANCE" "${GCLOUD_ARGS[@]}";;
 shell) [[ "$(status)" == RUNNING ]] || die 'Workstation not running'; gcloud compute ssh "$INSTANCE" "${GCLOUD_ARGS[@]}";;
 config-ssh) gcloud compute config-ssh --project "$PROJECT";;
 web-terminal) ensure_browser_app_tag code; rotate;;
  opencode) ensure_browser_app_tag opencode; rotate;;
  opencode-link)
    [[ "$(status)" == RUNNING ]] || die 'Workstation not running'
    ensure_setup
    ip="$(field 'networkInterfaces[0].accessConfigs[0].natIP')"
    [[ -n "$ip" ]] || die 'No external IP'
    link="$(gcloud compute ssh "$INSTANCE" "${GCLOUD_ARGS[@]}" --quiet \
      --command "timeout 20 sudo -u developer /home/developer/.opencode/bin/opencode pair --url https://$ip:$(app_service_field opencode port)" 2>/dev/null |
      grep -oE "https://$ip:$(app_service_field opencode port)/auth/connect/[A-Za-z0-9_-]+" | head -1)"
    [[ -n "$link" ]] || die 'Could not generate an opencode pairing link (is opencode running?)'
    echo "opencode link: $link (one-time, expires in 5 minutes)"
    ;;
  list)
    gcloud compute instances list --project "$PROJECT" --format='csv[no-heading](name,status,machineType.basename(),zone.basename(),networkInterfaces[0].accessConfigs[0].natIP,tags.items,labels.managed-workstation)' |
      while IFS=, read -r instance state machine zone ip tags managed; do
        [[ "$managed" == true ]] || continue
        secret="$instance-web-terminal-password"
        web_terminal_url=""
        opencode_url=""
        [[ "$tags" == *"$(browser_app_tag code)"* && -n "$ip" ]] && web_terminal_url="https://$ip:$(app_service_field code port)"
        [[ "$tags" == *"$(browser_app_tag opencode)"* && -n "$ip" ]] && opencode_url="https://$ip:$(app_service_field opencode port)"
        printf '%s,%s,%s,%s,%s,%s,%s,' "$instance" "$state" "$machine" "$zone" "$ip" "$web_terminal_url" "$opencode_url"
        if gcloud secrets describe "$secret" --project "$PROJECT" >/dev/null 2>&1; then
          printf 'https://console.cloud.google.com/security/secret-manager/secret/%s?project=%s' \
            "$secret" "$PROJECT"
        fi
        printf '\n'
      done
    ;;
 destroy)
   [[ -n "$(status)" ]] || { echo 'Workstation does not exist'; exit 0; }
   [[ "$(field 'labels.managed-workstation')" == true ]] || die 'Not a managed workstation; refusing to delete'
   if [[ "$YES" != true ]]; then read -r -p "Type $NAME to permanently delete VM and boot disk: " CONFIRM; [[ "$CONFIRM" == "$NAME" ]] || die 'Cancelled'; fi
   gcloud compute instances delete "$INSTANCE" "${GCLOUD_ARGS[@]}" --delete-disks boot --quiet
   ;;
esac
