#!/usr/bin/env bash
# Workstation command-line interface for Google Compute Engine.
#
# Creates and manages NixOS workstations. Creating a workstation builds the
# minimal NixOS GCE base image from this repository's flake, uploads it to
# Google Cloud, boots the instance from it, and then applies the full flake
# configuration with a normal `nixos-rebuild switch`.
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
NAME=main
PROJECT=""
ZONE=""
MACHINE_TYPE=e2-standard-2
BOOT_DISK_SIZE=100
WEB=false
YES=false
ACTION=""
SYSTEM="x86_64-linux"
TAG=workstation-web
usage() { cat <<'HELP'
Usage: workstation COMMAND [NAME] [--project PROJECT] [--zone ZONE]
       workstation create [NAME] [--machine-type TYPE] [--boot-disk-size GB] [--web-terminal]
       workstation configure [NAME]
       workstation recover [NAME]
Commands: create, configure, start, stop, list, shell, config-ssh, web-terminal, recover, destroy
web-terminal sets up browser access and issues a new website and recovery password.
configure re-applies the workstation flake (nixos-rebuild switch) to a running instance.
create builds the base image (requires a Linux machine with Nix) and deploys the flake.
recover boots a fresh instance from the base image with your original disk attached for rescue.
Default name: main. Default machine type: e2-standard-2. Default boot disk: 100 GB.
Create refuses to overwrite an existing workstation; destroy it first.
Stop retains disk; destroy permanently deletes disk.
HELP
}
die() { echo "workstation: $*" >&2; exit 1; }
while (($#)); do
 case "$1" in
   -h|--help) usage; exit 0;;
   --project|--zone|--machine-type|--boot-disk-size) (($#>=2)) || die "Missing value for $1"; case "$1" in --project) PROJECT="$2";; --zone) ZONE="$2";; --machine-type) MACHINE_TYPE="$2";; --boot-disk-size) BOOT_DISK_SIZE="$2";; esac; shift 2;;
   --project=*) PROJECT="${1#*=}"; shift;;
   --zone=*) ZONE="${1#*=}"; shift;;
   --machine-type=*) MACHINE_TYPE="${1#*=}"; shift;;
   --boot-disk-size=*) BOOT_DISK_SIZE="${1#*=}"; shift;;
   --web-terminal) WEB=true; shift;;
   --yes) YES=true; shift;;
   create|configure|start|stop|list|shell|config-ssh|web-terminal|recover|destroy) [[ -z "$ACTION" ]] || die 'Duplicate command'; ACTION="$1"; shift;;
   -*) die "Unknown option $1";;
   *) NAME="$1"; shift;;
 esac
done
[[ -n "$ACTION" ]] || { usage; exit 2; }
if [[ ! "$NAME" =~ ^[a-z]([-a-z0-9]*[a-z0-9])?$ ]] || ((${#NAME} > 47)); then
  die 'Invalid workstation name'
fi
command -v gcloud >/dev/null || die 'Install Google Cloud CLI'
PROJECT="${PROJECT:-$(gcloud config get-value project 2>/dev/null)}"
ZONE="${ZONE:-$(gcloud config get-value compute/zone 2>/dev/null)}"
[[ "$PROJECT" != '(unset)' && -n "$PROJECT" ]] || die 'Specify --project'
INSTANCE="workstation-$NAME"
BUCKET="workstation-images-$PROJECT"
SECRET_WEB="$INSTANCE-web-password"
SECRET_RECOVERY="$INSTANCE-recovery-password"
GC=(--project "$PROJECT")
if [[ "$ACTION" != list && "$ACTION" != config-ssh ]]; then
  [[ "$ZONE" != '(unset)' && -n "$ZONE" ]] || die 'Specify --zone'
  GC+=(--zone "$ZONE")
fi
field() { gcloud compute instances describe "$INSTANCE" "${GC[@]}" --format="value($1)" 2>/dev/null || true; }
status() { field status; }
external_ip() { field 'networkInterfaces[0].accessConfigs[0].natIP'; }
random_password() { head -c 64 /dev/urandom | base64 | tr -dc a-zA-Z0-9 | head -c 32; }
wait_ssh_for() {
  local instance="$1"
  for _ in {1..40}; do
    if gcloud compute ssh "developer@$instance" "${GC[@]}" --quiet --command true >/dev/null 2>&1; then return 0; fi
    sleep 5
  done
  die 'SSH did not become available'
}
wait_ssh() {
  wait_ssh_for "$INSTANCE"
}
ensure_bucket() {
  # The image bucket is provisioned by the Infra workflow
  # (infra/workstation/provision), not by instance lifecycle. Fail loudly with
  # the underlying error so missing or mis-scoped infrastructure is obvious.
  local error
  if ! error="$(gcloud storage buckets describe "gs://$BUCKET" --format='value(name)' 2>&1)"; then
    die "Image bucket gs://$BUCKET is not accessible: $error. Provision it with the Infra workflow (infra/workstation/provision)."
  fi
}
image_name() {
  local hash
  hash="$(basename "$1" | cut -d- -f1)"
  printf 'nixos-base-%s' "${hash:0:10}"
}
ensure_gce_image() {
  # Prints only the GCE image name on stdout; all progress goes to stderr so
  # it can be captured with $(). Requires a Linux machine with Nix.
  local out img file
  if [[ "$(uname -s)" != Linux ]]; then
    die 'Creating a NixOS instance builds the base image. Run from a Linux machine with Nix, or use the GitHub Actions workflow.'
  fi
  command -v nix >/dev/null || die 'Install Nix (with flakes) to build the base image'
  echo 'Building the base NixOS image...' >&2
  out="$(cd "$ROOT" && nix build ".#packages.$SYSTEM.gceImage" --no-link --print-out-paths)"
  img="$(image_name "$out")"
  if ! gcloud compute images describe "$img" --project "$PROJECT" >/dev/null 2>&1; then
    file="$(find "$out" -maxdepth 1 -type f -name '*.raw.tar.gz' -o -maxdepth 1 -type f -name '*.tar.gz' | head -1)"
    [[ -n "$file" ]] || die "Base image artifact not found in $out"
    echo "Uploading base image $img..." >&2
    if ! gsutil -q stat "gs://$BUCKET/${img}.tar.gz"; then
      gsutil -q cp "$file" "gs://$BUCKET/${img}.tar.gz"
    fi
    gcloud compute images create "$img" --project "$PROJECT" \
      --source-uri "gs://$BUCKET/${img}.tar.gz" \
      --storage-location "${ZONE%-*}" \
      --labels "managed-workstation=true" >/dev/null
  fi
  echo "$img"
}
deploy() {
  [[ "$(status)" == RUNNING ]] || die 'Workstation must be running'
  wait_ssh
  "$ROOT/infra/workstation/deploy" --instance "$INSTANCE" --project "$PROJECT" --zone "$ZONE" --repo "$ROOT"
}
add_secret() {
  local name="$1" value="$2" label="$3"
  if ! gcloud secrets describe "$name" --project "$PROJECT" >/dev/null 2>&1; then
    gcloud secrets create "$name" --project "$PROJECT" --replication-policy automatic \
      --labels managed-workstation=true,workstation="$NAME" >/dev/null
  fi
  if ! printf %s "$value" | gcloud secrets versions add "$name" --project "$PROJECT" --data-file=- >/dev/null; then
    die "$label password was changed on the VM but not saved in Secret Manager; run web-terminal again"
  fi
}
web_access() {
  local web recovery
  [[ "$(status)" == RUNNING ]] || die 'Workstation must be running'
  wait_ssh
  if [[ "$(field 'tags.items')" != *"$TAG"* ]]; then
    gcloud compute instances add-tags "$INSTANCE" "${GC[@]}" --tags "$TAG" >/dev/null
  fi
  # The workstation-web firewall rule (tcp:443 to this tag) is provisioned by
  # the Infra workflow, not created here.
  if ! gcloud compute firewall-rules describe "$TAG" --project "$PROJECT" >/dev/null 2>&1; then
    die 'Infrastructure is not provisioned: missing firewall rule '$TAG'. Run the Infra workflow (infra/workstation/provision) first.'
  fi
  web="$(random_password)"
  recovery="$(random_password)"
  {
    printf 'export WEB_PASSWORD=%q\n' "$web"
    printf 'export RECOVERY_PASSWORD=%q\n' "$recovery"
    cat "$ROOT/infra/workstation/web-access"
  } | gcloud compute ssh "developer@$INSTANCE" "${GC[@]}" --quiet --command 'sudo bash -s' >/dev/null
  add_secret "$SECRET_WEB" "$web" website
  add_secret "$SECRET_RECOVERY" "$recovery" recovery
  echo "browser: https://$(external_ip)"
  echo "password secret: $SECRET_WEB"
  echo "password: https://console.cloud.google.com/security/secret-manager/secret/$SECRET_WEB?project=$PROJECT"
  echo "recovery: https://console.cloud.google.com/security/secret-manager/secret/$SECRET_RECOVERY?project=$PROJECT"
}
case "$ACTION" in
 create)
    if [[ -n "$(status)" ]]; then
      # `create` never replaces an existing workstation; destroying is a
      # deliberate, separate step so a misapplied command cannot delete data.
      die "$INSTANCE already exists. Destroy it first with: scripts/workstation destroy $NAME"
    fi
    ensure_bucket
    IMG="$(ensure_gce_image)"
    gcloud compute machine-types describe "$MACHINE_TYPE" "${GC[@]}" >/dev/null
    # GCE serial console is enabled so a failed boot can be recovered from
    # the serial console. SSH keys are delivered by the guest agent.
    gcloud compute instances create "$INSTANCE" "${GC[@]}" \
      --machine-type "$MACHINE_TYPE" \
      --image "$IMG" \
      --boot-disk-size "$BOOT_DISK_SIZE" \
      --boot-disk-type pd-balanced \
      --labels managed-workstation=true \
      --metadata serial-port-enable=true
    deploy
    if [[ "$WEB" == true ]]; then web_access; fi
    ;;
  configure) deploy;;
  start)
    [[ -n "$(status)" ]] || die 'Workstation does not exist'
    if [[ "$(status)" != RUNNING ]]; then
      gcloud compute instances start "$INSTANCE" "${GC[@]}"
      if [[ "$(field 'tags.items')" == *"$TAG"* ]]; then web_access; fi
    fi
    ;;
  stop) [[ -n "$(status)" ]] || die 'Workstation does not exist'; [[ "$(status)" == TERMINATED ]] || gcloud compute instances stop "$INSTANCE" "${GC[@]}";;
  shell) [[ "$(status)" == RUNNING ]] || die 'Workstation not running'; gcloud compute ssh "developer@$INSTANCE" "${GC[@]}";;
  config-ssh) gcloud compute config-ssh --project "$PROJECT";;
  web-terminal) web_access;;
  recover)
    [[ -n "$(status)" ]] || die 'Workstation does not exist'
    RECOVERY_INSTANCE="$INSTANCE-recovery"
    if [[ -n "$(gcloud compute instances describe "$RECOVERY_INSTANCE" "${GC[@]}" --format='value(name)' 2>/dev/null)" ]]; then
      die "Recovery instance already exists: $RECOVERY_INSTANCE"
    fi
    ensure_bucket
    IMG="$(ensure_gce_image)"
    if [[ "$YES" != true ]]; then read -r -p "Recovering stops $INSTANCE and creates a rescue instance. Type $NAME to continue: " CONFIRM; [[ "$CONFIRM" == "$NAME" ]] || die 'Cancelled'; fi
    [[ "$(status)" == TERMINATED ]] || gcloud compute instances stop "$INSTANCE" "${GC[@]}"
    echo "Starting rescue instance $RECOVERY_INSTANCE..."
    gcloud compute instances create "$RECOVERY_INSTANCE" "${GC[@]}" \
      --machine-type "$MACHINE_TYPE" \
      --image "$IMG" \
      --boot-disk-size 20 \
      --boot-disk-type pd-balanced \
      --labels managed-workstation=true,recovery-of="$INSTANCE" \
      --metadata serial-port-enable=true
    wait_ssh_for "$RECOVERY_INSTANCE"
    gcloud compute instances attach-disk "$RECOVERY_INSTANCE" "${GC[@]}" \
      --disk "$INSTANCE" --device-name old-disk >/dev/null
    INSTANCE="$RECOVERY_INSTANCE"
    NAME="$NAME-recovery"
    deploy
    cat <<'EOF'
Recovery instance is ready. Your original disk is attached as /dev/disk/by-id/google-old-disk.
Recover files from it with:

  sudo mkdir -p /mnt/recovered
  ls /dev/disk/by-id/google-old-disk*
  sudo mount /dev/disk/by-id/google-old-disk-part1 /mnt/recovered

Then copy what you need, destroy the recovery instance, and create fresh via:
  scripts/workstation destroy RECOVERY
  scripts/workstation create main --web-terminal
EOF
    ;;
  list)
    gcloud compute instances list --project "$PROJECT" --format='csv[no-heading](name,status,machineType.basename(),zone.basename(),networkInterfaces[0].accessConfigs[0].natIP,tags.items,labels.managed-workstation)' |
      while IFS=, read -r instance state machine zone ip tags managed; do
        [[ "$managed" == true ]] || continue
        printf '%s,%s,%s,%s,%s' "$instance" "$state" "$machine" "$zone" "$ip"
        if [[ "$tags" == *"$TAG"* && -n "$ip" ]]; then
          web_secret="$instance-web-password"
          recovery_secret="$instance-recovery-password"
          printf ',https://%s,' "$ip"
          if gcloud secrets describe "$web_secret" --project "$PROJECT" >/dev/null 2>&1; then
            printf 'https://console.cloud.google.com/security/secret-manager/secret/%s?project=%s' \
              "$web_secret" "$PROJECT"
          fi
          if gcloud secrets describe "$recovery_secret" --project "$PROJECT" >/dev/null 2>&1; then
            printf ',https://console.cloud.google.com/security/secret-manager/secret/%s?project=%s' \
              "$recovery_secret" "$PROJECT"
          fi
        fi
        printf '\n'
      done
    ;;
  destroy)
    [[ -n "$(status)" ]] || { echo 'Workstation does not exist'; exit 0; }
    [[ "$(field 'labels.managed-workstation')" == true ]] || die 'Not a managed workstation; refusing to delete'
    if [[ "$YES" != true ]]; then read -r -p "Type $NAME to permanently delete VM and boot disk: " CONFIRM; [[ "$CONFIRM" == "$NAME" ]] || die 'Cancelled'; fi
    gcloud compute instances delete "$INSTANCE" "${GC[@]}" --delete-disks boot --quiet
    ;;
esac