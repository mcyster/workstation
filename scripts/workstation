#!/usr/bin/env bash
# Workstation command-line interface for Google Compute Engine.
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
NAME=main
PROJECT=""
ZONE=""
MACHINE_TYPE=e2-standard-2
IMAGE_PROJECT=ubuntu-os-cloud
IMAGE_FAMILY=ubuntu-2404-lts-amd64
ENVIRONMENT=""
ENVIRONMENTS=()
WEB=false
YES=false
ACTION=""
usage() { cat <<'HELP'
Usage: workstation COMMAND [NAME] [--project PROJECT] [--zone ZONE]
       workstation create [NAME] [--machine-type TYPE] [--web-terminal] [--environment NAME[,NAME...]]
       workstation configure [NAME] --environment NAME[,NAME...]
Commands: create, configure, idle-shutdown, start, stop, list, shell, config-ssh, web-terminal, destroy
web-terminal sets up browser access and issues a new password.
configure applies one or more environments (comma-separated) from environments/NAME.sh, in order.
idle-shutdown installs the auto-shutdown watchdog (also run automatically after setup).
Default name: main. Default machine type: e2-standard-2.
Stop retains disk; destroy permanently deletes disk.
HELP
}
die() { echo "workstation: $*" >&2; exit 1; }
while (($#)); do
 case "$1" in
   -h|--help) usage; exit 0;;
   --project|--zone|--machine-type|--environment) (($#>=2)) || die "Missing value for $1"; case "$1" in --project) PROJECT="$2";; --zone) ZONE="$2";; --machine-type) MACHINE_TYPE="$2";; --environment) ENVIRONMENT="$2";; esac; shift 2;;
   --project=*) PROJECT="${1#*=}"; shift;;
   --zone=*) ZONE="${1#*=}"; shift;;
   --machine-type=*) MACHINE_TYPE="${1#*=}"; shift;;
   --environment=*) ENVIRONMENT="${1#*=}"; shift;;
   --web-terminal) WEB=true; shift;;
   --yes) YES=true; shift;;
   create|configure|idle-shutdown|start|stop|list|shell|config-ssh|web-terminal|destroy) [[ -z "$ACTION" ]] || die 'Duplicate command'; ACTION="$1"; shift;;
   -*) die "Unknown option $1";;
   *) NAME="$1"; shift;;
 esac
done
[[ -n "$ACTION" ]] || { usage; exit 2; }
if [[ ! "$NAME" =~ ^[a-z]([-a-z0-9]*[a-z0-9])?$ ]] || ((${#NAME} > 47)); then
  die 'Invalid workstation name'
fi
if [[ -n "$ENVIRONMENT" ]]; then
  # Accept one or more environments, comma- or whitespace-separated.
  split="${ENVIRONMENT//[, ]/ }"
  split="${split//$'\n'/ }"
  read -r -a ENVIRONMENTS <<< "$split"
  filtered=()
  for environment in "${ENVIRONMENTS[@]}"; do
    [[ -n "$environment" ]] || continue
    [[ "$environment" =~ ^[a-z]([-a-z0-9]*[a-z0-9])?$ ]] || die "Invalid environment name: $environment"
    for seen in "${filtered[@]}"; do
      [[ "$seen" == "$environment" ]] && continue 2
    done
    filtered+=("$environment")
  done
  ENVIRONMENTS=("${filtered[@]}")
fi
[[ "$ACTION" != configure || -n "${ENVIRONMENTS[*]}" ]] || die 'configure requires --environment'
command -v gcloud >/dev/null || die 'Install Google Cloud CLI'
PROJECT="${PROJECT:-$(gcloud config get-value project 2>/dev/null)}"
ZONE="${ZONE:-$(gcloud config get-value compute/zone 2>/dev/null)}"
[[ "$PROJECT" != '(unset)' && -n "$PROJECT" ]] || die 'Specify --project'
INSTANCE="workstation-$NAME"
WEB_TERMINAL_SECRET="$INSTANCE-web-terminal-password"
CODE_SERVER_TAG=workstation-code-server
GCLOUD_ARGS=(--project "$PROJECT")
if [[ "$ACTION" != list && "$ACTION" != config-ssh ]]; then
 [[ "$ZONE" != '(unset)' && -n "$ZONE" ]] || die 'Specify --zone'
 GCLOUD_ARGS+=(--zone "$ZONE")
fi
field() { gcloud compute instances describe "$INSTANCE" "${GCLOUD_ARGS[@]}" --format="value($1)" 2>/dev/null || true; }
status() { field status; }
wait_ssh() {
  local attempt
  attempt=0
  while (( attempt < 40 )); do
    if gcloud compute ssh "$INSTANCE" "${GCLOUD_ARGS[@]}" --quiet --command true >/dev/null 2>&1; then return 0; fi
    sleep 5
    attempt=$(( attempt + 1 ))
  done
  die 'SSH did not become available'
}
ensure_setup() {
  wait_ssh
  if ! gcloud compute ssh "$INSTANCE" "${GCLOUD_ARGS[@]}" --quiet --command 'sudo test -f /var/lib/workstation-setup.done' >/dev/null 2>&1; then
    echo 'Completing workstation setup...'
    gcloud compute ssh "$INSTANCE" "${GCLOUD_ARGS[@]}" --quiet --command 'sudo bash -s' < "$ROOT/infra/workstation/setup"
  fi
  # Install (or refresh) the idle auto-shutdown watchdog on every management call.
  gcloud compute ssh "$INSTANCE" "${GCLOUD_ARGS[@]}" --quiet --command 'sudo bash -s' < "$ROOT/infra/workstation/idle-shutdown" >/dev/null || die 'Could not install idle shutdown'
  gcloud compute ssh "$INSTANCE" "${GCLOUD_ARGS[@]}" --quiet --command 'sudo test -f /var/lib/workstation-setup.done' >/dev/null 2>&1 || die 'Workstation setup did not complete'
}
read_environment_secret() {
  local name="$1"

  if [[ -v "$name" && -n "${!name}" ]]; then
    printf '%s' "${!name}"
    return 0
  fi
  return 1
}
configure_environment() {
  [[ "$(status)" == RUNNING ]] || die 'Workstation must be running'
  ensure_setup

  local environment script bundle secret value
  for environment in "${ENVIRONMENTS[@]}"; do
    script="$ROOT/environments/$environment.sh"
    [[ -f "$script" ]] || die "Environment script not found: environments/$environment.sh"

    (
      umask 077
      bundle="$(mktemp)"
      trap 'rm -f "$bundle"' EXIT

      {
        printf 'set -euo pipefail\nset +x\n'
        printf 'export WORKSTATION_ENVIRONMENT=%q\n' "$environment"
        printf 'export WORKSTATION_NAME=%q\n' "$NAME"
        while IFS= read -r secret; do
          if ! value="$(read_environment_secret "$secret")"; then
            die "GitHub Environment secret is not configured: $secret"
          fi
          printf 'export %s=%q\n' "$secret" "$value"
        done < <(sed -nE 's/^#[[:space:]]+workstation-secret:[[:space:]]+([A-Z_][A-Z0-9_]*)[[:space:]]*$/\1/p' "$script" | sort -u)
        cat "$script"
      } > "$bundle"

      gcloud compute ssh "$INSTANCE" "${GCLOUD_ARGS[@]}" --quiet \
        --command 'sudo -H -u developer bash -l -se' < "$bundle"
    )

    echo "environment: $environment"
  done
}
rotate() {
  [[ "$(status)" == RUNNING ]] || die 'Workstation must be running'
  ensure_setup
  if [[ "$(field 'tags.items')" != *"$CODE_SERVER_TAG"* ]]; then
    gcloud compute instances add-tags "$INSTANCE" "${GCLOUD_ARGS[@]}" --tags "$CODE_SERVER_TAG" >/dev/null
  fi
  if ! gcloud compute firewall-rules describe "$CODE_SERVER_TAG" --project "$PROJECT" >/dev/null 2>&1; then
    gcloud compute firewall-rules create "$CODE_SERVER_TAG" --project "$PROJECT" --allow tcp:8443 --target-tags "$CODE_SERVER_TAG" >/dev/null
  fi
  local password
  password="$(head -c 64 /dev/urandom | base64 | tr -dc a-zA-Z0-9 | head -c 32)"
  gcloud compute ssh "$INSTANCE" "${GCLOUD_ARGS[@]}" --quiet --command "CODE_SERVER_PASSWORD='$password' bash -s" < "$ROOT/infra/workstation/web-terminal" >/dev/null
  if ! gcloud secrets describe "$WEB_TERMINAL_SECRET" --project "$PROJECT" >/dev/null 2>&1; then
    gcloud secrets create "$WEB_TERMINAL_SECRET" --project "$PROJECT" --replication-policy automatic \
      --labels managed-workstation=true,workstation="$NAME" >/dev/null
  fi
  if ! printf %s "$password" | gcloud secrets versions add "$WEB_TERMINAL_SECRET" --project "$PROJECT" --data-file=- >/dev/null; then
    die 'Password changed on VM but not saved in Secret Manager. Run web-terminal again.'
  fi
  echo "web terminal: https://$(field 'networkInterfaces[0].accessConfigs[0].natIP'):8443"
  echo "secret: $WEB_TERMINAL_SECRET"
  echo "password: https://console.cloud.google.com/security/secret-manager/secret/$WEB_TERMINAL_SECRET?project=$PROJECT"
}
case "$ACTION" in
 create)
    if [[ -z "$(status)" ]]; then
      gcloud compute machine-types describe "$MACHINE_TYPE" "${GCLOUD_ARGS[@]}" >/dev/null
      # GCE executes startup-script metadata directly; no cloud-init dependency is required.
      gcloud compute instances create "$INSTANCE" "${GCLOUD_ARGS[@]}" \
        --machine-type "$MACHINE_TYPE" \
        --image-project "$IMAGE_PROJECT" \
        --image-family "$IMAGE_FAMILY" \
        --labels managed-workstation=true \
        --metadata-from-file="startup-script=$ROOT/infra/workstation/setup"
    else echo "$INSTANCE already exists"; fi
    if [[ "$WEB" == true ]]; then rotate; else ensure_setup; fi
    [[ -z "$ENVIRONMENT" ]] || configure_environment
    ;;
  configure) configure_environment;;
 idle-shutdown)
   [[ "$(status)" == RUNNING ]] || die 'Workstation not running'
   gcloud compute ssh "$INSTANCE" "${GCLOUD_ARGS[@]}" --quiet --command 'sudo bash -s' < "$ROOT/infra/workstation/idle-shutdown"
   ;;
 start)
   [[ -n "$(status)" ]] || die 'Workstation does not exist'
   if [[ "$(status)" != RUNNING ]]; then
     gcloud compute instances start "$INSTANCE" "${GCLOUD_ARGS[@]}"
     if [[ "$(field 'tags.items')" == *"$CODE_SERVER_TAG"* ]]; then rotate; fi
   fi
   ;;
 stop) [[ -n "$(status)" ]] || die 'Workstation does not exist'; [[ "$(status)" == TERMINATED ]] || gcloud compute instances stop "$INSTANCE" "${GCLOUD_ARGS[@]}";;
 shell) [[ "$(status)" == RUNNING ]] || die 'Workstation not running'; gcloud compute ssh "$INSTANCE" "${GCLOUD_ARGS[@]}";;
 config-ssh) gcloud compute config-ssh --project "$PROJECT";;
 web-terminal) rotate;;
  list)
    gcloud compute instances list --project "$PROJECT" --format='csv[no-heading](name,status,machineType.basename(),zone.basename(),networkInterfaces[0].accessConfigs[0].natIP,tags.items,labels.managed-workstation)' |
      while IFS=, read -r instance state machine zone ip tags managed; do
        [[ "$managed" == true ]] || continue
        printf '%s,%s,%s,%s,%s' "$instance" "$state" "$machine" "$zone" "$ip"
        if [[ "$tags" == *"$CODE_SERVER_TAG"* && -n "$ip" ]]; then
          secret="$instance-web-terminal-password"
          printf ',https://%s:8443,' "$ip"
          if gcloud secrets describe "$secret" --project "$PROJECT" >/dev/null 2>&1; then
            printf 'https://console.cloud.google.com/security/secret-manager/secret/%s?project=%s' \
              "$secret" "$PROJECT"
          fi
        fi
        printf '\n'
      done
    ;;
 destroy)
   [[ -n "$(status)" ]] || { echo 'Workstation does not exist'; exit 0; }
   [[ "$(field 'labels.managed-workstation')" == true ]] || die 'Not a managed workstation; refusing to delete'
   if [[ "$YES" != true ]]; then read -r -p "Type $NAME to permanently delete VM and boot disk: " CONFIRM; [[ "$CONFIRM" == "$NAME" ]] || die 'Cancelled'; fi
   gcloud compute instances delete "$INSTANCE" "${GCLOUD_ARGS[@]}" --delete-disks boot --quiet
   ;;
esac
