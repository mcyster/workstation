#!/usr/bin/env bash
# Push local workstation secrets into GitHub repository secrets so the
# workflow can provision them to instances (WORKSTATION_ENV_<NAME>).
#
# Reads .env.<NAME> files (by default every ~/.env.* in your home, or an
# explicit list of names) and pushes each file's content to the repository
# secret WORKSTATION_ENV_<NAME (uppercased)> with the GitHub CLI.
#
# Values are never printed. A local fingerprint state avoids rewriting
# unchanged secrets, so repeated runs are no-ops. The secrets themselves stay
# on this machine only.
set -euo pipefail

REPO="${WORKSTATION_REPO:-}"
SOURCE_DIR="${WORKSTATION_ENV_DIR:-$HOME}"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/workstation"
STATE_FILE="$STATE_DIR/secret-sync.json"
YES=false
FORCE=false
NAMES=()

die() { echo "push-environment-secrets: $*" >&2; exit 1; }
command -v gh >/dev/null || die 'Install the GitHub CLI (included in the development shell)'

while (($#)); do
  case "$1" in
    --repo) (($# >= 2)) || die "Missing value for $1"; REPO="$2"; shift 2 ;;
    --repo=*) REPO="${1#*=}"; shift ;;
    --dir) (($# >= 2)) || die "Missing value for $1"; SOURCE_DIR="$2"; shift 2 ;;
    --dir=*) SOURCE_DIR="${1#*=}"; shift ;;
    --yes) YES=true; shift ;;
    --force) FORCE=true; shift ;;
    -h|--help)
      cat <<'HELP'
Usage: push-environment-secrets [NAME...] [options]

Read .env.NAME files and push their contents to GitHub as repository secrets
WORKSTATION_ENV_<NAME>. With no NAME, every ~/.env.* (or --dir/.env.*) file in
scope is pushed. The instance pulls them via the workflow (WORKSTATION_ENV_*
secrets) and writes them to /var/lib/workstation/secrets/.env.NAME.

Examples:
  push-environment-secrets                  # every ~/.env.* discovered
  push-environment-secrets opencode tog     # just those two
  push-environment-secrets --dir ~/secrets  # read ~/secrets/.env.<name>

Options:
  --repo OWNER/REPO   repository to set secrets in (default: current repo)
  --dir DIR           read .env.<name> files from DIR instead of $HOME
  --yes               push without interactive confirmation
  --force             push again even if the local fingerprint is unchanged
HELP
      exit 0
      ;;
    -*) die "Unknown option $1" ;;
    *) NAMES+=("$1"); shift ;;
  esac
done

if [[ -z "$REPO" ]]; then
  REPO="$(gh repo view --json nameWithOwner -q .nameWithOwner 2>/dev/null || true)"
fi
[[ -n "$REPO" ]] || die 'Specify --repo OWNER/REPO (or run inside the repository)'

# Discover names from the source dir unless explicit names were given.
if ((${#NAMES[@]} == 0)); then
  for f in "$SOURCE_DIR"/.env.*; do
    [[ -f "$f" ]] || continue
    name="${f##*.env.}"
    NAMES+=("$name")
  done
  ((${#NAMES[@]} == 0)) && die "No .env.* files found in $SOURCE_DIR"
fi

mkdir -p "$STATE_DIR"
touch "$STATE_FILE"

# Validate a secret name before it is used in a path or a GitHub secret name.
validate_name() {
  [[ "$1" =~ ^[a-z][a-z0-9_-]*$ ]] || die "Invalid secret name: $1"
}
secret_name() { printf 'WORKSTATION_ENV_%s\n' "$(printf '%s' "$1" | tr '[:lower:]' '[:upper:]')"; }
fingerprint_of() { sha256sum "$1" | awk '{print $1}'; }
state_key() { printf '%s|%s' "$REPO" "$1"; }

changed=0
skipped=0
for name in "${NAMES[@]}"; do
  validate_name "$name"
  file="$SOURCE_DIR/.env.$name"
  if [[ ! -f "$file" ]]; then
    # Discovery never yields missing files, so a miss here means an explicitly
    # named secret that doesn't exist locally — fail rather than silently skip.
    die "no $file for secret $name"
  fi
  [[ -s "$file" ]] || { echo "skip $name: $file is empty"; continue; }
  key="$(state_key "$name")"
  fingerprint="$(fingerprint_of "$file")"
  stored="$(grep -o "\"$key\":\"[^\"]*\"\$" "$STATE_FILE" 2>/dev/null | cut -d: -f2 | tr -d '"' || true)"
  stored="${stored:-}"
  if [[ "$FORCE" == false && "$stored" == "$fingerprint" ]]; then
    echo "same $name: $(secret_name "$name") unchanged"
    skipped=$((skipped + 1))
    continue
  fi
  echo "push $name: $(secret_name "$name") from $file"
  changed=$((changed + 1))
done

if ((changed > 0)); then
  echo "This uploads $changed secret file(s) to $REPO as repository-level secrets. Values are never printed."
  if [[ "$YES" != true ]]; then
    printf 'Continue? [y/N] '
    read -r response
    [[ "$response" == y || "$response" == Y ]] || { echo 'Cancelled'; exit 0; }
  fi
  for name in "${NAMES[@]}"; do
    validate_name "$name"
    file="$SOURCE_DIR/.env.$name"
    [[ -s "$file" ]] || continue
    key="$(state_key "$name")"
    fingerprint="$(fingerprint_of "$file")"
    stored="$(grep -o "\"$key\":\"[^\"]*\"\$" "$STATE_FILE" 2>/dev/null | cut -d: -f2 | tr -d '"' || true)"
    stored="${stored:-}"
    if [[ "$FORCE" == false && "$stored" == "$fingerprint" ]]; then continue; fi
    # Pipe the value on stdin: gh reads the secret from standard input, which
    # avoids shell-quoting issues and the @-prefix file interpretation of
    # --body, and never echoes the value.
    cat "$file" | gh secret set "$(secret_name "$name")" --repo "$REPO" >/dev/null
    # state keys look like "REPO|name", so use # (absent from keys and
    # fingerprints) as the sed delimiter rather than |.
    if grep -q "\"$key\":" "$STATE_FILE"; then
      sed -i "s#\"$key\":\"[^\"]*\"#\"$key\":\"$fingerprint\"#" "$STATE_FILE"
    else
      printf '"%s":"%s"\n' "$key" "$fingerprint" >> "$STATE_FILE"
    fi
  done
else
  echo "nothing to push (all fingerprints current)"
fi
echo "summary: $changed pushed, $skipped unchanged"
