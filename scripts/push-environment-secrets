#!/usr/bin/env bash
# Push local tool env files (e.g. ~/.env.opencode) into GitHub secrets so the
# workstation configure flow can materialize them (WORKSTATION_ENV_<TOOL>).
#
# Values are pushed as one fixed-name secret per tool, either at repository
# level or into a specific GitHub Environment (--env). Secrets can't be read
# back, so a local fingerprint state avoids rewriting unchanged values.
#
# The secrets repo stays on this machine; the workstation never holds a key
# for it.
set -euo pipefail

REPO="${WORKSTATION_REPO:-}"
ENV_NAME=""
SOURCE_DIR="${WORKSTATION_ENV_DIR:-$HOME}"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/workstation"
STATE_FILE="$STATE_DIR/secret-sync.json"
YES=false
FORCE=false
TOOLS=()

die() { echo "push-environment-secrets: $*" >&2; exit 1; }
command -v gh >/dev/null || die 'Install the GitHub CLI (nix shell nixpkgs#gh)'

while (($#)); do
  case "$1" in
    --repo) (($# >= 2)) || die "Missing value for $1"; REPO="$2"; shift 2 ;;
    --repo=*) REPO="${1#*=}"; shift ;;
    --env) (($# >= 2)) || die "Missing value for $1"; ENV_NAME="$2"; shift 2 ;;
    --env=*) ENV_NAME="${1#*=}"; shift ;;
    --dir) (($# >= 2)) || die "Missing value for $1"; SOURCE_DIR="$2"; shift 2 ;;
    --dir=*) SOURCE_DIR="${1#*=}"; shift ;;
    --yes) YES=true; shift ;;
    --force) FORCE=true; shift ;;
    -h|--help)
      cat <<'HELP'
Usage: push-environment-secrets [TOOL...] [options]

Read ~/.env.<TOOL> (or --dir/.env.<TOOL>) and push its contents to GitHub as
the secret WORKSTATION_ENV_<TOOL>, repository-level by default or into the
GitHub Environment named by --env.

Tools default to: code opencode tog

Options:
  --repo OWNER/REPO   repository to set secrets in
  --env NAME          set secrets in GitHub Environment NAME instead
  --dir DIR           read .env.<tool> files from DIR instead of $HOME
  --yes               push without interactive confirmation
  --force             push again even if the local fingerprint is unchanged
HELP
      exit 0
      ;;
    -*) die "Unknown option $1" ;;
    *) TOOLS+=("$1"); shift ;;
  esac
done

if [[ -z "$REPO" ]]; then
  README_REPO="$(gh repo view --json nameWithOwner -q .nameWithOwner 2>/dev/null || true)"
  REPO="${README_REPO:-}"
fi
[[ -n "$REPO" ]] || die 'Specify --repo OWNER/REPO (or run inside the repository)'

((${#TOOLS[@]})) || TOOLS=(code opencode tog)

mkdir -p "$STATE_DIR"
touch "$STATE_FILE"

secret_name() { printf 'WORKSTATION_ENV_%s\n' "$(printf '%s' "$1" | tr '[:lower:]' '[:upper:]')"; }
fingerprint_of() { sha256sum "$1" | awk '{print $1}'; }
state_key() { printf '%s|%s|%s' "$REPO" "${ENV_NAME:-repo}" "$1"; }

changed=0; skipped=0
for tool in "${TOOLS[@]}"; do
  file="$SOURCE_DIR/.env.$tool"
  if [[ ! -f "$file" ]]; then
    echo "skip $tool: no $file"
    continue
  fi
  [[ -s "$file" ]] || { echo "skip $tool: $file is empty"; continue; }
  name="$(secret_name "$tool")"
  key="$(state_key "$tool")"
  fingerprint="$(fingerprint_of "$file")"
  stored="$(grep -o "\"$key\":\"[^\"]*\"\$" "$STATE_FILE" 2>/dev/null | cut -d: -f2 | tr -d '"' || true)"
  stored="${stored:-}"
  if [[ "$FORCE" == false && "$stored" == "$fingerprint" ]]; then
    echo "same $tool: $name unchanged"
    skipped=$((skipped + 1))
    continue
  fi
  echo "push $tool: $name (${ENV_NAME:+--env $ENV_NAME}) from $file"
  changed=$((changed + 1))
done

if (( changed > 0 )); then
  echo "This uploads $changed tool file(s) to GitHub (${ENV_NAME:+Environment $ENV_NAME in }$REPO). Values are never printed."
  if [[ "$YES" != true ]]; then
    printf 'Continue? [y/N] '
    read -r response
    [[ "$response" == y || "$response" == Y ]] || { echo 'Cancelled'; exit 0; }
  fi
  for tool in "${TOOLS[@]}"; do
    file="$SOURCE_DIR/.env.$tool"
    [[ -s "$file" ]] || continue
    name="$(secret_name "$tool")"
    key="$(state_key "$tool")"
    fingerprint="$(fingerprint_of "$file")"
    stored="$(grep -o "\"$key\":\"[^\"]*\"\$" "$STATE_FILE" 2>/dev/null | cut -d: -f2 | tr -d '"' || true)"
    stored="${stored:-}"
    if [[ "$FORCE" == false && "$stored" == "$fingerprint" ]]; then continue; fi
    if [[ -n "$ENV_NAME" ]]; then
      gh secret set "$name" --repo "$REPO" --env "$ENV_NAME" --body "$(cat "$file")" >/dev/null
    else
      gh secret set "$name" --repo "$REPO" --body "$(cat "$file")" >/dev/null
    fi
    if grep -q "\"$key\":" "$STATE_FILE"; then
      sed -i "s|\"$key\":\"[^\"]*\"|\"$key\":\"$fingerprint\"|" "$STATE_FILE"
    else
      printf '"%s":"%s"\n' "$key" "$fingerprint" >> "$STATE_FILE"
    fi
  done
else
  echo "nothing to push (all fingerprints current)"
fi
echo "summary: $changed pushed, $skipped unchanged"